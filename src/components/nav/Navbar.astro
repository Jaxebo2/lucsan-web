---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';

/**
 * Navbar — floating glass pill (Dynamic Island-inspired).
 *
 * - Centered, floats with margin from top
 * - Glass background adapts to underlying section (data-theme="light|dark")
 * - Logo swaps + nav link colors adapt
 * - Active link: coral text + animated dot indicator
 * - Mobile: compact pill with logo + hamburger; drawer is fullscreen
 */

const navLinks: { label: string; href: string }[] = [
  { label: 'Servicios', href: '/servicios' },
  { label: 'Sectores', href: '/sectores' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Sobre nosotros', href: '/sobre-nosotros' },
  { label: 'Contacto', href: '/contacto' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string): boolean => {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/') return currentPath === '/';
  return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
};
---

<header
  id="site-navbar"
  class:list={[
    'fixed inset-x-0 top-3 z-40 flex justify-center px-3 md:top-5 md:px-6',
    'transition-[color] duration-300 ease-out',
    'nav--light',
  ]}
>
  <div class="nav-pill relative flex h-16 items-center gap-3 rounded-full pl-4 pr-5 md:h-[72px] md:gap-6 md:pl-7 md:pr-5">
    {/* Logo */}
    <a
      href="/"
      class="flex items-center px-2 py-1 transition-opacity hover:opacity-80 md:px-3"
      aria-label="Lucsan Design · Inicio"
    >
      <img
        src="/brand/LucsanDesign-horizontal-azul oscuro.svg"
        alt="Lucsan Design"
        class="nav-logo nav-logo--dark h-6 w-auto md:h-7"
        width="140"
        height="28"
      />
      <img
        src="/brand/LucsanDesign-horizontal-blanco.svg"
        alt="Lucsan Design"
        class="nav-logo nav-logo--light h-6 w-auto md:h-7"
        width="140"
        height="28"
      />
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center gap-2 md:flex" aria-label="Primaria">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              data-active={active ? 'true' : 'false'}
              aria-current={active ? 'page' : undefined}
              class="nav-link relative inline-flex items-center px-4 py-2 text-sm font-medium"
            >
              <span class="nav-link__label relative inline-block">{link.label}</span>
            </a>
          );
        })
      }
    </nav>

    {/* Desktop CTA */}
    <div class="hidden md:ml-3 md:block">
      <Button href="/contacto" size="sm" variant="primary" iconRight="ph:arrow-right-bold">
        Conversemos
      </Button>
    </div>

    {/* Mobile hamburger */}
    <button
      id="nav-toggle"
      type="button"
      class="nav-toggle ml-1 inline-flex h-9 w-9 items-center justify-center rounded-full transition-colors md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <Icon name="ph:list-bold" class="h-6 w-6" />
    </button>
  </div>

  {/* Mobile drawer */}
  <div
    id="nav-drawer"
    class="fixed inset-0 z-50 hidden bg-brand-black text-neutral-50"
    aria-hidden="true"
  >
    <div class="flex h-16 items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2" aria-label="Lucsan Design · Inicio">
        <img
          src="/brand/LucsanDesign-horizontal-blanco.svg"
          alt="Lucsan Design"
          class="h-7 w-auto"
          width="160"
          height="32"
        />
      </a>
      <button
        id="nav-close"
        type="button"
        class="text-neutral-50"
        aria-label="Cerrar menú"
      >
        <Icon name="ph:x-bold" class="h-7 w-7" />
      </button>
    </div>
    <nav class="flex flex-col gap-2 px-6 py-8" aria-label="Móvil">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'border-b border-neutral-700 py-4 font-display text-3xl font-medium transition-colors',
                active ? 'text-brand-coral' : 'text-neutral-50 hover:text-brand-coral',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <div class="mt-6">
        <Button href="/contacto" variant="primary" size="lg" fullWidth iconRight="ph:arrow-right-bold">
          Conversemos
        </Button>
      </div>
    </nav>
  </div>
</header>

<style is:global>
  /* ============================================================
     Pill glass surface — adapts to light/dark via parent class
     ============================================================ */

  .nav-pill {
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition:
      background-color 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: background-color;
  }

  /* Light theme (over light sections) */
  #site-navbar.nav--light .nav-pill {
    background-color: color-mix(in oklab, var(--color-neutral-50) 72%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-neutral-300) 60%, transparent);
    box-shadow:
      0 8px 24px color-mix(in oklab, var(--color-brand-black) 8%, transparent),
      0 1px 0 color-mix(in oklab, white 50%, transparent) inset;
  }
  #site-navbar.nav--light .nav-link {
    color: var(--color-brand-black);
  }
  #site-navbar.nav--light .nav-logo--dark { display: block; }
  #site-navbar.nav--light .nav-logo--light { display: none; }
  #site-navbar.nav--light .nav-toggle { color: var(--color-brand-black); }

  /* Dark theme (over dark sections) */
  #site-navbar.nav--dark .nav-pill {
    background-color: color-mix(in oklab, var(--color-brand-black) 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-neutral-50) 12%, transparent);
    box-shadow:
      0 8px 24px color-mix(in oklab, var(--color-brand-black) 30%, transparent),
      0 1px 0 color-mix(in oklab, white 8%, transparent) inset;
  }
  #site-navbar.nav--dark .nav-link {
    color: var(--color-neutral-50);
  }
  #site-navbar.nav--dark .nav-logo--dark { display: none; }
  #site-navbar.nav--dark .nav-logo--light { display: block; }
  #site-navbar.nav--dark .nav-toggle { color: var(--color-neutral-50); }

  /* ============================================================
     Nav link animation — color + dot indicator
     ============================================================ */

  .nav-link {
    transition: color 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover,
  .nav-link[data-active='true'] {
    color: var(--color-brand-coral) !important;
  }

  /* Underline indicator under label text — scales from center */
  .nav-link__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -5px;
    height: 2.5px;
    border-radius: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover .nav-link__label::after,
  .nav-link[data-active='true'] .nav-link__label::after {
    transform: scaleX(1);
  }

  /* Hamburger hover hint */
  #site-navbar.nav--light .nav-toggle:hover {
    background-color: color-mix(in oklab, var(--color-brand-black) 6%, transparent);
  }
  #site-navbar.nav--dark .nav-toggle:hover {
    background-color: color-mix(in oklab, var(--color-neutral-50) 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill,
    .nav-link,
    .nav-link__label::after {
      transition: none !important;
    }
  }
</style>

<script>
  // ============================================================
  // Adaptive theme — IntersectionObserver on [data-theme] sections
  // ============================================================
  const navbar = document.getElementById('site-navbar');
  if (navbar) {
    const sections = document.querySelectorAll<HTMLElement>('[data-theme]');
    if (sections.length > 0) {
      const setTheme = (theme: 'light' | 'dark') => {
        navbar.classList.remove('nav--light', 'nav--dark');
        navbar.classList.add(`nav--${theme}`);
      };

      const navHeight = navbar.offsetHeight;
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible[0]) {
            const theme = (visible[0].target.getAttribute('data-theme') as 'light' | 'dark') ?? 'light';
            setTheme(theme);
          }
        },
        {
          rootMargin: `-${navHeight + 24}px 0px -${window.innerHeight - navHeight - 25}px 0px`,
          threshold: 0,
        },
      );
      sections.forEach((s) => observer.observe(s));
    }
  }

  // ============================================================
  // Mobile drawer
  // ============================================================
  const toggle = document.getElementById('nav-toggle');
  const close = document.getElementById('nav-close');
  const drawer = document.getElementById('nav-drawer');

  const openDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.classList.remove('hidden');
    drawer.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.classList.add('hidden');
    drawer.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', openDrawer);
  close?.addEventListener('click', closeDrawer);

  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
      closeDrawer();
    }
  });
</script>
