---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';

/**
 * Navbar — floating glass pill con dropdowns en Servicios y Sectores.
 *
 * Adapta tema (light/dark) según la sección visible debajo.
 * Servicios y Sectores muestran un dropdown al hacer hover (desktop) o tap (mobile).
 */

const navLinks: { label: string; href: string; hasDropdown?: boolean }[] = [
  { label: 'Servicios', href: '/servicios', hasDropdown: true },
  { label: 'Sectores', href: '/sectores', hasDropdown: true },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Sobre nosotros', href: '/sobre-nosotros' },
  { label: 'Contacto', href: '/contacto' },
];

// Cargar servicios + sectores publicados para los dropdowns
const servicios = (await getCollection('services', (s) => s.data.publicado))
  .sort((a, b) => a.data.orden - b.data.orden);
const sectores = (await getCollection('sectores', (s) => s.data.publicado))
  .sort((a, b) => a.data.orden - b.data.orden);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string): boolean => {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === '/') return currentPath === '/';
  return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
};
---

<header
  id="site-navbar"
  class:list={[
    'fixed inset-x-0 top-3 z-40 flex justify-center px-3 md:top-5 md:px-6',
    'transition-[color] duration-300 ease-out',
    'nav--light',
  ]}
>
  <div class="nav-pill relative flex h-16 items-center gap-3 rounded-full pl-4 pr-5 md:h-[72px] md:gap-6 md:pl-7 md:pr-5">
    {/* Logo */}
    <a
      href="/"
      class="flex items-center px-2 py-1 transition-opacity hover:opacity-80 md:px-3"
      aria-label="Lucsan Design · Inicio"
    >
      <img
        src="/brand/LucsanDesign-horizontal-azul oscuro.svg"
        alt="Lucsan Design"
        class="nav-logo nav-logo--dark h-6 w-auto md:h-7"
        width="140"
        height="28"
      />
      <img
        src="/brand/LucsanDesign-horizontal-blanco.svg"
        alt="Lucsan Design"
        class="nav-logo nav-logo--light h-6 w-auto md:h-7"
        width="140"
        height="28"
      />
    </a>

    {/* Desktop nav */}
    <nav class="hidden items-center gap-2 md:flex" aria-label="Primaria">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          const hasDropdown = link.hasDropdown;
          return (
            <div class:list={['nav-item relative', hasDropdown && 'nav-item--has-dropdown']}>
              <a
                href={link.href}
                data-active={active ? 'true' : 'false'}
                aria-current={active ? 'page' : undefined}
                class="nav-link relative inline-flex items-center gap-1 px-4 py-2 text-sm font-medium"
              >
                <span class="nav-link__label relative inline-block">{link.label}</span>
                {hasDropdown && (
                  <Icon name="ph:caret-down-bold" class="nav-link__caret h-3 w-3" />
                )}
              </a>

              {hasDropdown && link.label === 'Servicios' && (
                <div class="nav-dropdown" role="menu">
                  <div class="nav-dropdown__inner">
                    <div class="grid gap-1">
                      {servicios.map((s) => (
                        <a
                          href={`/servicios/${s.data.slug}`}
                          class="nav-dropdown__link group"
                          role="menuitem"
                        >
                          <span class="nav-dropdown__label">{s.data.title}</span>
                          <Icon
                            name="ph:arrow-right-bold"
                            class="nav-dropdown__arrow h-4 w-4 transition-transform group-hover:translate-x-1"
                          />
                        </a>
                      ))}
                    </div>
                    <a href="/servicios" class="nav-dropdown__footer">
                      Ver todos los servicios
                      <Icon name="ph:arrow-right-bold" class="h-3 w-3" />
                    </a>
                  </div>
                </div>
              )}

              {hasDropdown && link.label === 'Sectores' && (
                <div class="nav-dropdown nav-dropdown--wide" role="menu">
                  <div class="nav-dropdown__inner">
                    <div class="grid grid-cols-2 gap-x-6 gap-y-1">
                      {sectores.map((sec) => (
                        <a
                          href={`/sectores/${sec.data.slug}`}
                          class="nav-dropdown__link group"
                          role="menuitem"
                        >
                          <span class="nav-dropdown__label">{sec.data.nombre}</span>
                          <Icon
                            name="ph:arrow-right-bold"
                            class="nav-dropdown__arrow h-4 w-4 transition-transform group-hover:translate-x-1"
                          />
                        </a>
                      ))}
                    </div>
                    <a href="/sectores" class="nav-dropdown__footer">
                      Ver todos los sectores
                      <Icon name="ph:arrow-right-bold" class="h-3 w-3" />
                    </a>
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </nav>

    {/* Desktop CTA */}
    <div class="hidden md:ml-3 md:block">
      <Button href="/contacto" size="sm" variant="primary" iconRight="ph:arrow-right-bold">
        Conversemos
      </Button>
    </div>

    {/* Mobile hamburger */}
    <button
      id="nav-toggle"
      type="button"
      class="nav-toggle ml-1 inline-flex h-9 w-9 items-center justify-center rounded-full transition-colors md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <Icon name="ph:list-bold" class="h-6 w-6" />
    </button>
  </div>

  {/* Mobile drawer */}
  <div
    id="nav-drawer"
    class="fixed inset-0 z-50 hidden overflow-y-auto bg-brand-black text-neutral-50"
    aria-hidden="true"
  >
    <div class="flex h-16 items-center justify-between px-6">
      <a href="/" class="flex items-center gap-2" aria-label="Lucsan Design · Inicio">
        <img
          src="/brand/LucsanDesign-horizontal-blanco.svg"
          alt="Lucsan Design"
          class="h-7 w-auto"
          width="160"
          height="32"
        />
      </a>
      <button id="nav-close" type="button" class="text-neutral-50" aria-label="Cerrar menú">
        <Icon name="ph:x-bold" class="h-7 w-7" />
      </button>
    </div>
    <nav class="flex flex-col gap-1 px-6 py-8 pb-24" aria-label="Móvil">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'border-b border-neutral-700 py-4 font-display text-2xl font-medium transition-colors',
                active ? 'text-brand-coral' : 'text-neutral-50 hover:text-brand-coral',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }

      {/* Sub-links de servicios en mobile */}
      <div class="mt-6">
        <p class="text-xs font-medium uppercase tracking-widest text-neutral-500">
          Servicios
        </p>
        <ul class="mt-3 flex flex-col gap-2">
          {
            servicios.map((s) => (
              <li>
                <a
                  href={`/servicios/${s.data.slug}`}
                  class="text-sm text-neutral-300 transition-colors hover:text-brand-coral"
                >
                  {s.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-6">
        <p class="text-xs font-medium uppercase tracking-widest text-neutral-500">
          Sectores
        </p>
        <ul class="mt-3 grid grid-cols-2 gap-2">
          {
            sectores.slice(0, 12).map((sec) => (
              <li>
                <a
                  href={`/sectores/${sec.data.slug}`}
                  class="text-sm text-neutral-300 transition-colors hover:text-brand-coral"
                >
                  {sec.data.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-8">
        <Button href="/contacto" variant="primary" size="lg" fullWidth iconRight="ph:arrow-right-bold">
          Conversemos
        </Button>
      </div>
    </nav>
  </div>
</header>

<style is:global>
  /* ============================================================
     Pill glass surface — adapts to light/dark via parent class
     ============================================================ */

  .nav-pill {
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition:
      background-color 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms cubic-bezier(0.22, 1, 0.36, 1),
      height 400ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 400ms cubic-bezier(0.22, 1, 0.36, 1),
      gap 400ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: background-color, height, padding;
  }

  /* === Shrink al scroll === */
  /* Pill se achica: menos altura, padding y gap */
  #site-navbar.nav--shrunk .nav-pill {
    height: 52px;
    padding-left: 12px;
    padding-right: 12px;
    gap: 8px;
  }
  @media (min-width: 768px) {
    #site-navbar.nav--shrunk .nav-pill {
      height: 56px;
      padding-left: 20px;
      padding-right: 20px;
      gap: 18px;
    }
  }
  /* Logo más chico cuando shrunk */
  #site-navbar.nav--shrunk .nav-logo {
    height: 1.25rem; /* h-5 */
    transition: height 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-logo {
    transition: height 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Nav links menor padding */
  #site-navbar.nav--shrunk .nav-link {
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
  }
  .nav-link {
    transition:
      color 250ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 400ms cubic-bezier(0.22, 1, 0.36, 1),
      font-size 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* === Expandir al hover incluso si está shrunk === */
  /* Cuando el navbar está shrunk PERO se hace hover sobre la pill, expandir */
  #site-navbar.nav--shrunk:hover .nav-pill,
  #site-navbar.nav--shrunk:focus-within .nav-pill {
    height: 64px;
    padding-left: 16px;
    padding-right: 16px;
    gap: 12px;
  }
  @media (min-width: 768px) {
    #site-navbar.nav--shrunk:hover .nav-pill,
    #site-navbar.nav--shrunk:focus-within .nav-pill {
      height: 72px;
      padding-left: 28px;
      padding-right: 20px;
      gap: 24px;
    }
  }
  #site-navbar.nav--shrunk:hover .nav-logo,
  #site-navbar.nav--shrunk:focus-within .nav-logo {
    height: 1.75rem; /* h-7 */
  }
  #site-navbar.nav--shrunk:hover .nav-link,
  #site-navbar.nav--shrunk:focus-within .nav-link {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  #site-navbar.nav--light .nav-pill {
    background-color: color-mix(in oklab, var(--color-neutral-50) 72%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-neutral-300) 60%, transparent);
    box-shadow:
      0 8px 24px color-mix(in oklab, var(--color-brand-black) 8%, transparent),
      0 1px 0 color-mix(in oklab, white 50%, transparent) inset;
  }
  #site-navbar.nav--light .nav-link { color: var(--color-brand-black); }
  #site-navbar.nav--light .nav-logo--dark { display: block; }
  #site-navbar.nav--light .nav-logo--light { display: none; }
  #site-navbar.nav--light .nav-toggle { color: var(--color-brand-black); }

  #site-navbar.nav--dark .nav-pill {
    background-color: color-mix(in oklab, var(--color-brand-black) 55%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-neutral-50) 12%, transparent);
    box-shadow:
      0 8px 24px color-mix(in oklab, var(--color-brand-black) 30%, transparent),
      0 1px 0 color-mix(in oklab, white 8%, transparent) inset;
  }
  #site-navbar.nav--dark .nav-link { color: var(--color-neutral-50); }
  #site-navbar.nav--dark .nav-logo--dark { display: none; }
  #site-navbar.nav--dark .nav-logo--light { display: block; }
  #site-navbar.nav--dark .nav-toggle { color: var(--color-neutral-50); }

  /* ============================================================
     Nav link animation + underline
     ============================================================ */

  .nav-link {
    transition: color 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover,
  .nav-link[data-active='true'] {
    color: var(--color-brand-coral) !important;
  }

  .nav-link__label::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -5px;
    height: 2.5px;
    border-radius: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-link:hover .nav-link__label::after,
  .nav-link[data-active='true'] .nav-link__label::after {
    transform: scaleX(1);
  }

  .nav-link__caret {
    transition: transform 250ms ease;
  }
  .nav-item--has-dropdown:hover .nav-link__caret,
  .nav-item--has-dropdown:focus-within .nav-link__caret {
    transform: rotate(180deg);
  }

  /* ============================================================
     Dropdowns
     ============================================================ */

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    /* Bridge invisible para que el mouse no se pierda en el gap. */
    padding-top: 10px;
    transform: translateX(-50%) translateY(-6px);
    min-width: 280px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 200ms;
  }
  .nav-dropdown--wide {
    min-width: 560px;
  }

  /* Show dropdown on hover or focus of parent.
     También se mantiene cuando el mouse está sobre el .nav-dropdown mismo,
     porque éste hereda el hover desde el padre. */
  .nav-item--has-dropdown:hover .nav-dropdown,
  .nav-item--has-dropdown:focus-within .nav-dropdown,
  .nav-dropdown:hover {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown__inner {
    background-color: #ffffff;
    border: 1px solid color-mix(in oklab, var(--color-neutral-300) 70%, transparent);
    border-radius: 1rem;
    padding: 0.75rem;
    box-shadow: 0 16px 40px color-mix(in oklab, var(--color-brand-black) 15%, transparent);
  }
  #site-navbar.nav--dark .nav-dropdown__inner {
    background-color: var(--color-brand-black);
    border-color: color-mix(in oklab, var(--color-neutral-50) 18%, transparent);
  }

  .nav-dropdown__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-brand-black);
    transition: background-color 150ms ease, color 150ms ease;
  }
  #site-navbar.nav--dark .nav-dropdown__link { color: var(--color-neutral-50); }
  .nav-dropdown__link:hover {
    background-color: color-mix(in oklab, var(--color-brand-coral) 8%, transparent);
    color: var(--color-brand-coral);
  }
  .nav-dropdown__arrow {
    opacity: 0;
    transition: opacity 150ms ease, transform 150ms ease;
  }
  .nav-dropdown__link:hover .nav-dropdown__arrow {
    opacity: 1;
  }

  .nav-dropdown__footer {
    margin-top: 0.5rem;
    padding: 0.625rem 0.875rem;
    border-top: 1px solid color-mix(in oklab, var(--color-neutral-300) 60%, transparent);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-coral);
    transition: opacity 150ms ease;
  }
  #site-navbar.nav--dark .nav-dropdown__footer {
    border-top-color: color-mix(in oklab, var(--color-neutral-50) 15%, transparent);
  }
  .nav-dropdown__footer:hover { opacity: 0.8; }

  /* Hamburger hover */
  #site-navbar.nav--light .nav-toggle:hover {
    background-color: color-mix(in oklab, var(--color-brand-black) 6%, transparent);
  }
  #site-navbar.nav--dark .nav-toggle:hover {
    background-color: color-mix(in oklab, var(--color-neutral-50) 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill,
    .nav-link,
    .nav-link__label::after,
    .nav-link__caret,
    .nav-dropdown {
      transition: none !important;
    }
  }
</style>

<script>
  // Adaptive theme — IntersectionObserver on [data-theme] sections
  const navbar = document.getElementById('site-navbar');
  if (navbar) {
    const sections = document.querySelectorAll<HTMLElement>('[data-theme]');
    if (sections.length > 0) {
      const setTheme = (theme: 'light' | 'dark') => {
        navbar.classList.remove('nav--light', 'nav--dark');
        navbar.classList.add(`nav--${theme}`);
      };

      const navHeight = navbar.offsetHeight;
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible[0]) {
            const theme = (visible[0].target.getAttribute('data-theme') as 'light' | 'dark') ?? 'light';
            setTheme(theme);
          }
        },
        {
          rootMargin: `-${navHeight + 24}px 0px -${window.innerHeight - navHeight - 25}px 0px`,
          threshold: 0,
        },
      );
      sections.forEach((s) => observer.observe(s));
    }
  }

  // Shrink al scroll: agrega clase nav--shrunk cuando scrollY > 80
  if (navbar) {
    const onScroll = () => {
      navbar.classList.toggle('nav--shrunk', window.scrollY > 80);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Mobile drawer
  const toggle = document.getElementById('nav-toggle');
  const close = document.getElementById('nav-close');
  const drawer = document.getElementById('nav-drawer');

  const openDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.classList.remove('hidden');
    drawer.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeDrawer = () => {
    if (!drawer || !toggle) return;
    drawer.classList.add('hidden');
    drawer.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', openDrawer);
  close?.addEventListener('click', closeDrawer);
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
      closeDrawer();
    }
  });
</script>
