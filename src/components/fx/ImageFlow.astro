---
/**
 * ImageFlow — galería horizontal con cards de alturas variadas (offset
 * vertical alternado), drag-to-scroll, scale on hover y botones de nav.
 *
 * Inspirado en framer image-flow: cards a alturas distintas para crear
 * sensación de "flow" no lineal.
 */

interface Item {
  image?: string;
  alt?: string;
  caption?: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className = '' } = Astro.props as Props;
---

<div class:list={['image-flow relative', className]} data-image-flow>
  <div
    class="image-flow__track flex items-center gap-5 overflow-x-auto py-12 md:gap-7 md:py-16"
    style="scroll-snap-type: x mandatory; scrollbar-width: none;"
    data-image-flow-track
  >
    {
      items.map((item, i) => {
        const isTall = i % 3 === 0;
        const isMed = i % 3 === 1;
        const isShort = i % 3 === 2;
        const offsetY = i % 2 === 0 ? 'md:-translate-y-6' : 'md:translate-y-6';
        const heightClass = isTall ? 'h-[28rem] md:h-[34rem]' : isMed ? 'h-[24rem] md:h-[28rem]' : 'h-[20rem] md:h-[24rem]';
        const widthClass = isTall ? 'w-[18rem] md:w-[22rem]' : isMed ? 'w-[20rem] md:w-[24rem]' : 'w-[16rem] md:w-[20rem]';
        return (
          <div
            class:list={[
              'image-flow__item flex-none overflow-hidden rounded-2xl bg-neutral-200 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.03]',
              heightClass,
              widthClass,
              offsetY,
            ]}
            style="scroll-snap-align: center;"
          >
            {item.image ? (
              <img
                src={item.image}
                alt={item.alt || ''}
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-110"
              />
            ) : (
              <div class="relative flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-coral/30 via-brand-coral/8 to-neutral-200">
                <span class="absolute left-5 top-5 font-mono text-xs uppercase tracking-widest text-text-muted">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-display text-xl font-bold text-text-primary">
                  {item.caption || 'Imagen'}
                </span>
              </div>
            )}
          </div>
        );
      })
    }
  </div>

  {/* Controles */}
  <div class="mt-6 flex items-center justify-between">
    <p class="text-xs uppercase tracking-widest text-text-muted">
      ← Arrastra o desliza →
    </p>
    <div class="flex gap-2">
      <button
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-border-default transition-colors hover:border-brand-coral hover:bg-brand-coral hover:text-neutral-50"
        data-image-flow-prev
        aria-label="Anterior"
      >
        ←
      </button>
      <button
        type="button"
        class="flex h-11 w-11 items-center justify-center rounded-full border border-border-default transition-colors hover:border-brand-coral hover:bg-brand-coral hover:text-neutral-50"
        data-image-flow-next
        aria-label="Siguiente"
      >
        →
      </button>
    </div>
  </div>
</div>

<style>
  .image-flow__track::-webkit-scrollbar { display: none; }
  .image-flow__track { cursor: grab; }
  .image-flow__track:active { cursor: grabbing; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-image-flow]').forEach((flow) => {
    const track = flow.querySelector<HTMLElement>('[data-image-flow-track]');
    const prev = flow.querySelector<HTMLButtonElement>('[data-image-flow-prev]');
    const next = flow.querySelector<HTMLButtonElement>('[data-image-flow-next]');
    if (!track) return;

    // Botones
    const scrollByItems = (dir: number) => {
      const item = track.querySelector<HTMLElement>('.image-flow__item');
      if (!item) return;
      const itemWidth = item.offsetWidth + 28; // gap-7 = 28px
      track.scrollBy({ left: dir * itemWidth, behavior: 'smooth' });
    };
    prev?.addEventListener('click', () => scrollByItems(-1));
    next?.addEventListener('click', () => scrollByItems(1));

    // Drag to scroll
    let isDown = false;
    let startX = 0;
    let scrollLeftStart = 0;
    track.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeftStart = track.scrollLeft;
    });
    track.addEventListener('mouseleave', () => { isDown = false; });
    track.addEventListener('mouseup', () => { isDown = false; });
    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollLeftStart - walk;
    });
  });
</script>
