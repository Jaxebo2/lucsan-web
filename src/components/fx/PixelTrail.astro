---
/**
 * PixelTrail — canvas con grilla de pixeles que se iluminan cerca del cursor
 * y se apagan suavemente. Pensado para overlay en hero sections.
 */

interface Props {
  /** Tamaño de cada pixel (px). */
  size?: number;
  /** Color en hex. */
  color?: string;
  /** Radio de influencia del cursor (px). */
  radius?: number;
  /** Velocidad de fade (0-1, cada frame). */
  fadeSpeed?: number;
  class?: string;
}

const {
  size = 16,
  color = '#ff5548',
  radius = 90,
  fadeSpeed = 0.06,
  class: className = '',
} = Astro.props as Props;
---

<canvas
  class:list={['pixel-trail pointer-events-none absolute inset-0 h-full w-full', className]}
  data-pixel-trail
  data-size={size}
  data-color={color}
  data-radius={radius}
  data-fade={fadeSpeed}
  aria-hidden="true"
></canvas>

<script>
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (motionOk) {
    document.querySelectorAll<HTMLCanvasElement>('[data-pixel-trail]').forEach((canvas) => {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const size = parseInt(canvas.dataset.size || '16');
      const color = canvas.dataset.color || '#ff5548';
      const radius = parseInt(canvas.dataset.radius || '90');
      const fade = parseFloat(canvas.dataset.fade || '0.06');

      let cols = 0, rows = 0;
      let grid: number[] = []; // intensity 0-1 per cell
      let mx = -9999, my = -9999;

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        ctx.scale(dpr, dpr);
        cols = Math.ceil(rect.width / size);
        rows = Math.ceil(rect.height / size);
        grid = new Array(cols * rows).fill(0);
      };
      resize();
      window.addEventListener('resize', resize);

      const onMove = (e: MouseEvent) => {
        const rect = canvas.getBoundingClientRect();
        if (e.clientY < rect.top || e.clientY > rect.bottom) {
          mx = -9999;
          my = -9999;
          return;
        }
        mx = e.clientX - rect.left;
        my = e.clientY - rect.top;
      };
      window.addEventListener('mousemove', onMove);

      // Parse color to rgb
      const r = parseInt(color.slice(1, 3), 16);
      const g = parseInt(color.slice(3, 5), 16);
      const b = parseInt(color.slice(5, 7), 16);

      const draw = () => {
        const rect = canvas.getBoundingClientRect();
        ctx.clearRect(0, 0, rect.width, rect.height);

        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const i = y * cols + x;
            const cx = x * size + size / 2;
            const cy = y * size + size / 2;
            const dx = cx - mx;
            const dy = cy - my;
            const dist = Math.sqrt(dx * dx + dy * dy);
            let value = grid[i] ?? 0;
            if (dist < radius) {
              const influence = 1 - dist / radius;
              if (influence > value) value = influence;
            }
            if (value > 0) {
              ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${value * 0.6})`;
              ctx.fillRect(x * size, y * size, size - 1, size - 1);
              value -= fade;
              if (value < 0) value = 0;
            }
            grid[i] = value;
          }
        }

        requestAnimationFrame(draw);
      };
      draw();
    });
  }
</script>
