---
/**
 * PremiumTimeline — timeline vertical premium con número grande, línea de
 * progreso animada al scroll, items con scale-in al entrar al viewport
 * y hover effect.
 */

import { Icon } from 'astro-icon/components';

interface Item {
  numero: string;
  titulo: string;
  descripcion: string;
  entregables?: string[];
}

interface Props {
  items: Item[];
  variant?: 'light' | 'dark';
  class?: string;
}

const { items, variant = 'light', class: className = '' } = Astro.props as Props;
const isDark = variant === 'dark';
---

<div class:list={['premium-timeline relative', className]} data-premium-timeline>
  {/* Línea vertical de fondo */}
  <span
    class:list={[
      'absolute left-7 top-12 h-[calc(100%-3rem)] w-px md:left-10',
      isDark ? 'bg-neutral-700' : 'bg-border-default',
    ]}
    aria-hidden="true"
  ></span>

  {/* Línea de progreso coral animada con scroll */}
  <span
    class="premium-timeline__progress absolute left-7 top-12 w-px bg-brand-coral md:left-10"
    data-timeline-progress
    aria-hidden="true"
  ></span>

  <ol class="flex flex-col gap-16 md:gap-20">
    {
      items.map((item, i) => (
        <li
          class="premium-timeline__item group relative flex gap-6 md:gap-10"
          data-timeline-item
        >
          {/* Número grande con círculo coral */}
          <div class="relative flex-none">
            <span
              class:list={[
                'flex h-14 w-14 items-center justify-center rounded-full border-2 font-display text-lg font-bold transition-transform duration-500 group-hover:scale-110 md:h-20 md:w-20 md:text-2xl',
                isDark
                  ? 'border-brand-coral bg-brand-black text-text-inverse'
                  : 'border-brand-coral bg-surface-page text-text-accent',
              ]}
            >
              {item.numero}
            </span>
            {/* Pulso decorativo */}
            <span
              class="absolute inset-0 -z-10 animate-ping rounded-full border-2 border-brand-coral opacity-0 group-hover:opacity-30"
              aria-hidden="true"
            ></span>
          </div>

          {/* Contenido */}
          <div class="flex-1 pt-2 md:pt-4">
            <p class:list={['mb-2 font-mono text-xs uppercase tracking-widest', isDark ? 'text-text-inverse-secondary' : 'text-text-muted']}>
              Fase {item.numero}
            </p>
            <h3
              class:list={[
                'font-display text-3xl font-bold leading-tight tracking-tight transition-colors duration-300 group-hover:text-text-accent md:text-5xl',
                isDark ? 'text-text-inverse' : 'text-text-primary',
              ]}
            >
              {item.titulo}
            </h3>
            <p
              class:list={[
                'mt-4 max-w-2xl text-base leading-relaxed md:text-lg',
                isDark ? 'text-text-inverse-secondary' : 'text-text-secondary',
              ]}
            >
              {item.descripcion}
            </p>

            {item.entregables && item.entregables.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {item.entregables.map((e) => (
                  <li
                    class:list={[
                      'inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors',
                      isDark
                        ? 'border-neutral-700 bg-neutral-800/50 text-text-inverse'
                        : 'border-border-default bg-surface-elevated text-text-primary',
                    ]}
                  >
                    <Icon name="ph:check-bold" class="h-3.5 w-3.5 text-text-accent" />
                    {e}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* Items visibles por defecto (sin depender de JS). Si IntersectionObserver
     se activa, animan; sino quedan visibles igual. */
  .premium-timeline__item {
    opacity: 1;
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-premium-timeline]').forEach((timeline) => {
    const progress = timeline.querySelector<HTMLElement>('[data-timeline-progress]');

    // Progress fill al scroll
    if (progress) {
      const onScroll = () => {
        const rect = timeline.getBoundingClientRect();
        const viewportH = window.innerHeight;
        const startY = viewportH * 0.55;
        const total = rect.height - 48; // -3rem para no llegar a tope
        const visible = Math.min(total, Math.max(0, startY - rect.top));
        progress.style.height = `${visible}px`;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }

    // No-op: items ya son visibles por CSS, no necesitamos JS reveal
  });
</script>
