---
/**
 * AccordionSlider — VERTICAL accordion. Click expande hacia abajo
 * con animación smooth. Solo uno abierto a la vez.
 */

import { Icon } from 'astro-icon/components';

interface Panel {
  titulo: string;
  descripcion: string;
  icon?: string;
  image?: string;
}

interface Props {
  panels: Panel[];
  class?: string;
}

const { panels, class: className = '' } = Astro.props as Props;
---

<div class:list={['vertical-accordion flex flex-col gap-3', className]} data-vertical-accordion>
  {
    panels.map((panel, i) => (
      <div
        class="va-item rounded-2xl border border-border-subtle bg-surface-elevated overflow-hidden transition-all duration-300"
        data-va-item
        data-va-open={i === 0 ? 'true' : 'false'}
      >
        <button
          type="button"
          class="va-trigger flex w-full items-center gap-5 p-6 text-left md:p-8"
          data-va-trigger
          aria-expanded={i === 0 ? 'true' : 'false'}
        >
          <span class="va-index font-mono text-xs text-text-muted md:text-sm">
            {String(i + 1).padStart(2, '0')}
          </span>
          {panel.icon && (
            <Icon name={panel.icon} class="va-icon h-7 w-7 flex-none text-text-accent" />
          )}
          <h3 class="va-title flex-1 font-display text-xl font-bold tracking-tight md:text-3xl">
            {panel.titulo}
          </h3>
          <span class="va-caret flex h-10 w-10 flex-none items-center justify-center rounded-full border border-current transition-transform duration-300">
            <Icon name="ph:plus-bold" class="h-4 w-4" />
          </span>
        </button>

        <div class="va-body" data-va-body>
          <div class="va-body-inner px-6 pb-8 pl-[5.5rem] md:px-8 md:pb-10 md:pl-24">
            <p class="text-base leading-relaxed text-text-secondary md:text-lg">
              {panel.descripcion}
            </p>
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .va-item[data-va-open='true'] {
    border-color: var(--color-brand-coral);
  }
  .va-item[data-va-open='true'] .va-title {
    color: var(--color-brand-coral);
  }
  .va-item[data-va-open='true'] .va-caret {
    transform: rotate(45deg);
    color: var(--color-brand-coral);
  }

  /* Body collapse smooth — usa grid-template-rows trick (animable) */
  .va-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .va-item[data-va-open='true'] .va-body {
    grid-template-rows: 1fr;
  }
  .va-body-inner {
    overflow: hidden;
  }

  /* Hover state cuando está cerrado */
  .va-item:not([data-va-open='true']):hover {
    border-color: color-mix(in oklab, var(--color-brand-coral) 40%, transparent);
  }
  .va-item:not([data-va-open='true']):hover .va-title {
    color: var(--color-brand-coral);
  }

  @media (prefers-reduced-motion: reduce) {
    .va-item,
    .va-body,
    .va-caret {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-vertical-accordion]').forEach((accordion) => {
    const items = accordion.querySelectorAll<HTMLElement>('[data-va-item]');
    items.forEach((item, idx) => {
      const trigger = item.querySelector<HTMLButtonElement>('[data-va-trigger]');
      if (!trigger) return;
      trigger.addEventListener('click', () => {
        const isOpen = item.dataset.vaOpen === 'true';
        // Cerrar todos primero (acordeón clásico — solo uno abierto)
        items.forEach((it) => {
          it.dataset.vaOpen = 'false';
          const t = it.querySelector<HTMLButtonElement>('[data-va-trigger]');
          t?.setAttribute('aria-expanded', 'false');
        });
        // Si NO estaba abierto, abrir este
        if (!isOpen) {
          item.dataset.vaOpen = 'true';
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>
