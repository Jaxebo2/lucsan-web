---
/**
 * AccordionSlider — HORIZONTAL accordion. Hover sobre un panel lo expande
 * con animación real flex-grow (CSS plain, no Tailwind shorthand).
 */

import { Icon } from 'astro-icon/components';

interface Panel {
  titulo: string;
  descripcion: string;
  icon?: string;
  image?: string;
}

interface Props {
  panels: Panel[];
  class?: string;
}

const { panels, class: className = '' } = Astro.props as Props;
---

<div
  class:list={['accordion-slider flex flex-col gap-3 md:h-[440px] md:flex-row md:gap-3', className]}
  data-accordion-slider
>
  {
    panels.map((panel, i) => (
      <button
        type="button"
        class="accordion-slider__panel group relative overflow-hidden rounded-2xl bg-brand-black text-left"
        data-panel-index={i}
        aria-expanded={i === 0 ? 'true' : 'false'}
      >
        {panel.image ? (
          <img src={panel.image} alt="" class="absolute inset-0 h-full w-full object-cover opacity-50" />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-brand-coral/40 via-brand-coral/10 to-brand-black"></div>
        )}
        <span aria-hidden="true" class="accordion-slider__overlay absolute inset-0 bg-brand-black/40"></span>

        <div class="relative flex h-full flex-col justify-between p-6 md:p-8">
          <div class="flex items-start justify-between">
            <span class="font-mono text-xs uppercase tracking-widest text-neutral-50/70">
              {String(i + 1).padStart(2, '0')}
            </span>
            {panel.icon && <Icon name={panel.icon} class="h-7 w-7 text-text-accent" />}
          </div>

          <div>
            <h3 class="accordion-slider__title font-display text-2xl font-bold leading-tight text-neutral-50 md:text-3xl">
              {panel.titulo}
            </h3>
            <div class="accordion-slider__desc-wrap">
              <p class="accordion-slider__desc mt-3 max-w-md text-sm text-neutral-50/90 md:text-base">
                {panel.descripcion}
              </p>
            </div>
          </div>
        </div>
      </button>
    ))
  }
</div>

<style>
  .accordion-slider__panel {
    flex: 1 1 0;
    min-height: 220px;
    /* Transición REAL del flex-grow */
    transition: flex-grow 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Mobile: comportamiento stacked, sin animación horizontal */
  @media (min-width: 768px) {
    .accordion-slider__panel { min-height: 0; }
    /* Panel activo crece, los otros se contraen */
    .accordion-slider__panel[aria-expanded='true'] {
      flex-grow: 4;
    }
  }

  /* Overlay del panel — más oscuro cuando colapsado, más claro cuando expandido */
  .accordion-slider__overlay {
    transition: background-color 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .accordion-slider__panel[aria-expanded='true'] .accordion-slider__overlay {
    background-color: color-mix(in oklab, var(--color-brand-black) 25%, transparent);
  }

  /* Descripción: collapse smooth con grid trick */
  .accordion-slider__desc-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .accordion-slider__panel[aria-expanded='true'] .accordion-slider__desc-wrap {
    grid-template-rows: 1fr;
    transition-delay: 200ms;
  }
  .accordion-slider__desc {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-slider__panel,
    .accordion-slider__overlay,
    .accordion-slider__desc-wrap {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion-slider]').forEach((slider) => {
    const panels = slider.querySelectorAll<HTMLButtonElement>('.accordion-slider__panel');
    const setActive = (idx: number) => {
      panels.forEach((p, i) => p.setAttribute('aria-expanded', i === idx ? 'true' : 'false'));
    };
    panels.forEach((panel, idx) => {
      panel.addEventListener('mouseenter', () => setActive(idx));
      panel.addEventListener('focus', () => setActive(idx));
      panel.addEventListener('click', () => setActive(idx));
    });
  });
</script>
