---
/**
 * AnimatedMark — bloque decorativo animado para anclar visualmente sections.
 *
 * Renderiza el símbolo de Lucsan en grande con una animación sutil de
 * rotación lenta y un gradient mesh detrás. Pensado para hero de páginas
 * de servicio/sector. Respeta prefers-reduced-motion.
 *
 * Variants:
 * - coral (default): símbolo coral sobre tinte oscuro con halo
 * - dark: símbolo oscuro sobre tinte claro
 */

type Variant = 'coral' | 'dark';

interface Props {
  variant?: Variant;
  size?: 'md' | 'lg' | 'xl';
  class?: string;
}

const { variant = 'coral', size = 'lg', class: className = '' } = Astro.props as Props;

const sizeMap = {
  md: 'w-48 h-48',
  lg: 'w-64 h-64 md:w-80 md:h-80',
  xl: 'w-72 h-72 md:w-[28rem] md:h-[28rem]',
};

const logoSrc =
  variant === 'coral' ? '/brand/Simbolo-coral.svg' : '/brand/Simbolo-azul oscuro.svg';
---

<div class:list={['animated-mark relative', sizeMap[size], className]}>
  {/* Halo gradient detrás */}
  <div
    class:list={[
      'animated-mark__halo absolute inset-0 rounded-full blur-3xl opacity-40',
      variant === 'coral' ? 'bg-brand-coral' : 'bg-brand-blue',
    ]}
    aria-hidden="true"
  />
  {/* Símbolo rotando lentamente */}
  <div class="animated-mark__symbol absolute inset-0 flex items-center justify-center">
    <img
      src={logoSrc}
      alt=""
      aria-hidden="true"
      class="h-full w-full object-contain"
      loading="lazy"
    />
  </div>
</div>

<style>
  .animated-mark__symbol {
    animation: mark-rotate 40s linear infinite;
  }
  .animated-mark__halo {
    animation: mark-pulse 6s ease-in-out infinite;
  }

  @keyframes mark-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes mark-pulse {
    0%, 100% { opacity: 0.3; transform: scale(0.95); }
    50% { opacity: 0.55; transform: scale(1.05); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animated-mark__symbol,
    .animated-mark__halo {
      animation: none;
    }
  }
</style>
