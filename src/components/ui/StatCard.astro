---
import MotionCounter from '../fx/MotionCounter';

/**
 * StatCard — número grande animado + descripción.
 * Prefijo y sufijo se renderizan FUERA del counter, en tamaño menor.
 */

interface Props {
  valor: string | number;
  descripcion: string;
  prefijo?: string;
  sufijo?: string;
  tone?: 'primary' | 'inverse' | 'accent';
  mode?: 'count' | 'odometer';
  class?: string;
}

const {
  valor,
  descripcion,
  prefijo = '',
  sufijo = '',
  tone = 'accent',
  mode = 'count',
  class: className = '',
} = Astro.props as Props;

const toneClass = {
  primary: 'text-text-primary',
  inverse: 'text-text-inverse',
  accent: 'text-text-accent',
}[tone];

const descTone = tone === 'inverse' ? 'text-text-inverse-secondary' : 'text-text-secondary';

// Si valor viene como string con texto (ej "100%"), separar parte numérica del sufijo embebido
let mainValue: string | number = valor;
let inlineSuffix = sufijo;
if (typeof valor === 'string' && !sufijo) {
  const match = valor.match(/^([+\-]?)([\d.,]+)(.*)$/);
  if (match && match[3]) {
    mainValue = parseFloat(match[2]!.replace(/,/g, ''));
    inlineSuffix = match[3].trim();
  }
}

const numeric = typeof mainValue === 'number' ? mainValue : parseFloat(String(mainValue).replace(/[^\d.-]/g, ''));
const canAnimate = !Number.isNaN(numeric) && Number.isFinite(numeric);
---

<div class:list={['stat-card flex flex-col gap-3', className]} data-reveal>
  <div class="flex items-baseline gap-1.5 leading-none">
    {prefijo && (
      <span class:list={['font-display text-4xl font-bold leading-none md:text-5xl', toneClass]}>
        {prefijo}
      </span>
    )}
    {canAnimate ? (
      <MotionCounter
        client:visible
        value={numeric}
        mode={mode}
        className={`font-display text-5xl font-bold leading-none md:text-7xl ${toneClass}`}
      />
    ) : (
      <span class:list={['font-display text-5xl font-bold leading-none md:text-7xl', toneClass]}>
        {valor}
      </span>
    )}
    {inlineSuffix && (
      <span class:list={['font-display text-xl font-medium leading-none md:text-2xl', toneClass]}>
        {inlineSuffix}
      </span>
    )}
  </div>
  <p class:list={['text-sm leading-snug md:text-base', descTone]}>{descripcion}</p>
</div>
