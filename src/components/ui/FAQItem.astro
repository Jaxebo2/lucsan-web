---
import { Icon } from 'astro-icon/components';

interface Props {
  pregunta: string;
  open?: boolean;
}

const { pregunta, open = false } = Astro.props;
---

<details class="group py-5" open={open}>
  <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-lg font-medium leading-snug transition-colors hover:text-text-accent md:text-xl">
    <span>{pregunta}</span>
    <Icon
      name="ph:plus-bold"
      class="mt-1 h-5 w-5 flex-none text-text-muted transition-transform duration-200 group-open:rotate-45"
    />
  </summary>
  <div class="pt-4 text-text-secondary md:text-lg">
    <slot />
  </div>
</details>

<style>
  /* Hide native marker (Chrome/Safari/Firefox) */
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: '';
  }
</style>
