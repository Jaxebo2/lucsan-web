---
import MotionCounter from '../fx/MotionCounter';

/**
 * MetricBadge — métrica grande + label. Anima el número al entrar al viewport.
 * Usado en case studies. Si valor no es numérico, se renderiza tal cual.
 */

type Tone = 'accent' | 'inverse' | 'inherit';
type Align = 'left' | 'center';

interface Props {
  valor: string | number;
  descripcion: string;
  tone?: Tone;
  align?: Align;
  prefijo?: string;
  sufijo?: string;
  mode?: 'count' | 'odometer';
  class?: string;
}

const {
  valor,
  descripcion,
  tone = 'accent',
  align = 'left',
  prefijo = '',
  sufijo = '',
  mode = 'count',
  class: className = '',
} = Astro.props as Props;

const valorMap: Record<Tone, string> = {
  accent: 'text-text-accent',
  inverse: 'text-text-inverse',
  inherit: '',
};
const valorTone = valorMap[tone];

const descripcionMap: Record<Tone, string> = {
  accent: 'text-text-secondary',
  inverse: 'text-text-inverse-secondary',
  inherit: 'opacity-70',
};
const descripcionTone = descripcionMap[tone];

const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';

// Auto-extract sufijo del valor si viene como "+47%" o "200+"
let extractedPrefix = prefijo;
let extractedSuffix = sufijo;
let cleanValue: number | string = valor;

if (typeof valor === 'string' && !prefijo && !sufijo) {
  const match = valor.match(/^([+\-]?)([\d.,]+)(.*)$/);
  if (match) {
    extractedPrefix = match[1] || '';
    cleanValue = parseFloat(match[2]!.replace(/,/g, ''));
    extractedSuffix = match[3] || '';
  }
}

const numeric = typeof cleanValue === 'number' ? cleanValue : parseFloat(String(cleanValue).replace(/[^\d.-]/g, ''));
const canAnimate = !Number.isNaN(numeric) && Number.isFinite(numeric);
---

<div class:list={['flex flex-col gap-2', alignClass, className]}>
  {canAnimate ? (
    <MotionCounter
      client:visible
      value={numeric}
      prefix={extractedPrefix}
      suffix={extractedSuffix}
      mode={mode}
      className={`font-display text-5xl font-bold leading-none md:text-6xl ${valorTone}`}
    />
  ) : (
    <span class:list={['font-display text-5xl font-bold leading-none md:text-6xl', valorTone]}>
      {valor}
    </span>
  )}
  <span class:list={['max-w-[20ch] text-sm', descripcionTone]}>{descripcion}</span>
</div>
