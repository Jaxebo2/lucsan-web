---
/**
 * InteractiveGradient — gradient mesh líquido en movimiento constante
 * que además sigue al mouse con lag suave.
 *
 * Solo color coral (4 blobs de distinto tamaño y velocidad).
 * Cada blob tiene una animación CSS de "flujo" propia (28s-40s) + offset
 * del mouse encima vía CSS variables.
 *
 * En prefers-reduced-motion: solo animación ambiente, sin mouse tracking.
 */

type Variant = 'dark' | 'light';

interface Props {
  variant?: Variant;
  /** Intensidad (0-1). Más alto = blobs más visibles. */
  intensity?: number;
  class?: string;
}

const { variant = 'dark', intensity = 0.7, class: className = '' } = Astro.props as Props;
---

<div
  class:list={[
    'interactive-gradient pointer-events-none absolute inset-0 overflow-hidden',
    `interactive-gradient--${variant}`,
    className,
  ]}
  aria-hidden="true"
  style={`--ig-opacity: ${intensity}`}
  data-interactive-gradient
>
  {/* Track que se desplaza con el mouse */}
  <div class="ig-track">
    <span class="ig-blob ig-blob--1"></span>
    <span class="ig-blob ig-blob--2"></span>
    <span class="ig-blob ig-blob--3"></span>
    <span class="ig-blob ig-blob--4"></span>
  </div>

  {/* Capa de captura de mouse */}
  <div class="interactive-gradient__capture pointer-events-auto absolute inset-0"></div>
</div>

<style>
  .interactive-gradient {
    --ig-mx: 0;
    --ig-my: 0;
  }

  .ig-track {
    position: absolute;
    inset: 0;
    /* Mouse offset: el mouse desplaza el track entero hasta 4rem */
    transform: translate3d(
      calc(var(--ig-mx) * 4rem),
      calc(var(--ig-my) * 4rem),
      0
    );
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .ig-blob {
    position: absolute;
    border-radius: 50%;
    background: var(--color-brand-coral);
    filter: blur(110px);
    opacity: var(--ig-opacity);
    will-change: transform;
    mix-blend-mode: screen;
  }

  /* 4 blobs coral con animaciones de flujo distintas y desfasadas */
  .ig-blob--1 {
    width: 50rem;
    height: 50rem;
    top: -15rem;
    left: -10rem;
    animation: flow-a 28s ease-in-out infinite;
  }
  .ig-blob--2 {
    width: 38rem;
    height: 38rem;
    bottom: -12rem;
    right: -8rem;
    animation: flow-b 34s ease-in-out infinite;
  }
  .ig-blob--3 {
    width: 30rem;
    height: 30rem;
    top: 30%;
    left: 50%;
    animation: flow-c 40s ease-in-out infinite;
    opacity: calc(var(--ig-opacity) * 0.8);
  }
  .ig-blob--4 {
    width: 24rem;
    height: 24rem;
    bottom: 25%;
    left: 20%;
    animation: flow-d 32s ease-in-out infinite;
    opacity: calc(var(--ig-opacity) * 0.65);
  }

  @keyframes flow-a {
    0%, 100% { transform: translate(0, 0) scale(1); }
    20% { transform: translate(8rem, 6rem) scale(1.15); }
    40% { transform: translate(12rem, -4rem) scale(0.95); }
    60% { transform: translate(4rem, 10rem) scale(1.1); }
    80% { transform: translate(-2rem, 4rem) scale(1.05); }
  }
  @keyframes flow-b {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-8rem, -6rem) scale(1.1); }
    50% { transform: translate(-12rem, 4rem) scale(0.9); }
    75% { transform: translate(-4rem, -10rem) scale(1.2); }
  }
  @keyframes flow-c {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-10rem, 8rem) scale(0.85); }
    66% { transform: translate(8rem, -12rem) scale(1.2); }
  }
  @keyframes flow-d {
    0%, 100% { transform: translate(0, 0) scale(1); }
    30% { transform: translate(6rem, -8rem) scale(1.15); }
    60% { transform: translate(-8rem, 6rem) scale(0.9); }
  }

  /* Light variant: blend multiply para que se vea sobre fondo claro */
  .interactive-gradient--light .ig-blob {
    mix-blend-mode: multiply;
    opacity: calc(var(--ig-opacity) * 0.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .ig-track { transition: none; transform: none; }
    /* Mantener movimiento ambiente pero más lento y suave */
    .ig-blob--1 { animation-duration: 60s; }
    .ig-blob--2 { animation-duration: 70s; }
    .ig-blob--3 { animation-duration: 80s; }
    .ig-blob--4 { animation-duration: 66s; }
  }
</style>

<script>
  // Mouse tracking con interpolación suave
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (motionOk) {
    document.querySelectorAll<HTMLElement>('[data-interactive-gradient]').forEach((el) => {
      let mx = 0, my = 0, tx = 0, ty = 0; // valores en rango -1 a 1

      const setTarget = (clientX: number, clientY: number) => {
        const rect = el.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        // Normalizar a rango -1 a 1 respecto al centro del elemento
        tx = Math.max(-1, Math.min(1, (clientX - cx) / (rect.width / 2)));
        ty = Math.max(-1, Math.min(1, (clientY - cy) / (rect.height / 2)));
      };

      const onMove = (e: MouseEvent) => {
        const rect = el.getBoundingClientRect();
        // Solo seguir el mouse si está dentro de la sección verticalmente
        if (e.clientY < rect.top || e.clientY > rect.bottom) return;
        setTarget(e.clientX, e.clientY);
      };
      window.addEventListener('mousemove', onMove);

      const animate = () => {
        mx += (tx - mx) * 0.05;
        my += (ty - my) * 0.05;
        el.style.setProperty('--ig-mx', mx.toFixed(3));
        el.style.setProperty('--ig-my', my.toFixed(3));
        requestAnimationFrame(animate);
      };
      animate();
    });
  }
</script>
