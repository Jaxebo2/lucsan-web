---
import { Icon } from 'astro-icon/components';

/**
 * Button — Primary CTA with premium hover animations.
 *
 * Variants:
 * - primary:   coral → fills to black on hover (white text always)
 * - secondary: black → fills to coral on hover (white text always)
 * - outline:   transparent → fills to coral on hover (text turns white)
 * - ghost:     transparent → no fill, text shifts to accent
 *
 * All "coral surfaces" use white text per brand decision.
 *
 * Sizes: sm | md (default) | lg
 *
 * Icons (Phosphor names, e.g. "ph:arrow-right-bold"):
 * - iconRight: animated track — icon slides right while duplicate enters from left
 * - iconLeft:  reverse direction
 *
 * Rendered as <a> if `href` is provided, else <button>.
 */

type Variant = 'primary' | 'secondary' | 'outline' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: '_blank' | '_self';
  iconLeft?: string;
  iconRight?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  target,
  iconLeft,
  iconRight,
  fullWidth = false,
  disabled = false,
  ariaLabel,
  class: className = '',
} = Astro.props as Props;

const base =
  'btn group relative isolate inline-flex items-center justify-center gap-2 overflow-hidden rounded-full font-medium transition-colors duration-300 ease-out focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50';

const variantMap: Record<Variant, string> = {
  // White text always (resting + hover = both surfaces white-friendly: coral & black)
  primary:
    'bg-brand-coral text-neutral-50 focus-visible:outline-brand-coral',
  // White text always (resting on black, hover on coral — both fine with white)
  secondary:
    'bg-brand-black text-neutral-50 focus-visible:outline-brand-black',
  // Text inherits container color at rest; on hover it goes white (over coral fill)
  outline:
    'border border-current bg-transparent text-current hover:text-neutral-50',
  // No fill — only text color shift
  ghost:
    'bg-transparent text-current hover:text-brand-coral',
};

// Color that sweeps up from below on hover
const fillMap: Record<Variant, string> = {
  primary: 'bg-brand-black',   // coral → black
  secondary: 'bg-brand-coral', // black → coral
  outline: 'bg-brand-coral',   // transparent → coral
  ghost: 'bg-transparent',     // no fill
};

const sizeMap: Record<Size, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-5 py-2.5 text-sm md:px-6 md:py-3 md:text-base',
  lg: 'px-7 py-4 text-base md:text-lg',
};

// Icon wrapper size in em (matches text size). Using em keeps icon centered relative to text baseline.
const iconEm: Record<Size, string> = {
  sm: '1.1em',
  md: '1.15em',
  lg: '1.2em',
};

const variantClass = variantMap[variant];
const fillClass = fillMap[variant];
const sizeClass = sizeMap[size];
const iconBoxSize = iconEm[size];

const allClass = [base, variantClass, sizeClass, fullWidth && 'w-full', className];
const isLink = !!href;
// Solo aplicar magnético en primary CTAs (no en links secundarios)
const magnetic = variant === 'primary' || variant === 'secondary';
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;

const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
---

{
  isLink ? (
    <a href={href} target={target} rel={rel} aria-label={ariaLabel} class:list={allClass} data-smart-hover={magnetic ? '0.18' : undefined}>
      <span
        aria-hidden="true"
        class:list={[
          'btn-fill pointer-events-none absolute -inset-px -z-10 translate-y-[105%] transition-transform duration-500 group-hover:translate-y-0',
          fillClass,
        ]}
        style={`transition-timing-function: ${ease}`}
      />
      <span class="relative z-10 inline-flex items-center gap-2">
        {iconLeft && (
          <span
            class="btn-icon relative inline-flex flex-none items-center overflow-hidden"
            style={`width: ${iconBoxSize}; height: ${iconBoxSize}`}
          >
            <span
              class="btn-icon-track flex h-full translate-x-0 transition-transform duration-500 group-hover:-translate-x-1/2"
              style={`transition-timing-function: ${ease};`}
            >
              <Icon name={iconLeft} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
              <Icon name={iconLeft} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
            </span>
          </span>
        )}
        <slot />
        {iconRight && (
          <span
            class="btn-icon relative inline-flex flex-none items-center overflow-hidden"
            style={`width: ${iconBoxSize}; height: ${iconBoxSize}`}
          >
            <span
              class="btn-icon-track flex h-full -translate-x-1/2 transition-transform duration-500 group-hover:translate-x-0"
              style={`transition-timing-function: ${ease};`}
            >
              <Icon name={iconRight} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
              <Icon name={iconRight} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
            </span>
          </span>
        )}
      </span>
    </a>
  ) : (
    <button type={type} disabled={disabled} aria-label={ariaLabel} class:list={allClass} data-smart-hover={magnetic ? '0.18' : undefined}>
      <span
        aria-hidden="true"
        class:list={[
          'btn-fill pointer-events-none absolute -inset-px -z-10 translate-y-[105%] transition-transform duration-500 group-hover:translate-y-0',
          fillClass,
        ]}
        style={`transition-timing-function: ${ease}`}
      />
      <span class="relative z-10 inline-flex items-center gap-2">
        {iconLeft && (
          <span
            class="btn-icon relative inline-flex flex-none items-center overflow-hidden"
            style={`width: ${iconBoxSize}; height: ${iconBoxSize}`}
          >
            <span
              class="btn-icon-track flex h-full translate-x-0 transition-transform duration-500 group-hover:-translate-x-1/2"
              style={`transition-timing-function: ${ease};`}
            >
              <Icon name={iconLeft} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
              <Icon name={iconLeft} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
            </span>
          </span>
        )}
        <slot />
        {iconRight && (
          <span
            class="btn-icon relative inline-flex flex-none items-center overflow-hidden"
            style={`width: ${iconBoxSize}; height: ${iconBoxSize}`}
          >
            <span
              class="btn-icon-track flex h-full -translate-x-1/2 transition-transform duration-500 group-hover:translate-x-0"
              style={`transition-timing-function: ${ease};`}
            >
              <Icon name={iconRight} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
              <Icon name={iconRight} class="h-full flex-none" style={`width: ${iconBoxSize}`} />
            </span>
          </span>
        )}
      </span>
    </button>
  )
}

<style>
  /* Force GPU compositing on the fill to avoid sub-pixel peek on rounded edges */
  .btn-fill {
    will-change: transform;
    backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn-fill,
    .btn-icon-track {
      transition: none !important;
    }
  }
</style>
