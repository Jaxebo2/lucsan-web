---
import { Icon } from 'astro-icon/components';

/**
 * Button — CTA premium con dos efectos de hover según haya icono o no.
 *
 * CON iconRight:
 *   - El icono vive en un círculo de color contraste a la derecha.
 *   - En hover, ese círculo se expande hasta cubrir todo el botón.
 *   - El icono se anima (slide derecha + segundo icono entrando por izq).
 *   - Texto y icono siempre visibles (z-index > fill).
 *
 * SIN iconRight:
 *   - En hover, un círculo de color contraste se expande DESDE LA POSICIÓN
 *     del cursor (mousemove track via CSS vars --mx/--my).
 *   - clip-path: circle(0%) → circle(150%).
 *
 * Variant ghost: solo cambio de color de texto, sin fill.
 */

type Variant = 'primary' | 'secondary' | 'outline' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: '_blank' | '_self';
  iconLeft?: string;
  iconRight?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  target,
  iconLeft,
  iconRight,
  fullWidth = false,
  disabled = false,
  ariaLabel,
  class: className = '',
} = Astro.props as Props;

const surfaceMap: Record<Variant, string> = {
  primary: 'bg-brand-coral text-neutral-50',
  secondary: 'bg-brand-black text-neutral-50',
  outline: 'border border-brand-black bg-transparent text-brand-black',
  ghost: 'bg-transparent text-current',
};

// Color del fill (círculo del icono / radial expand)
const fillMap: Record<Variant, string> = {
  primary: '#0a0a0a',   // coral → fill negro
  secondary: '#ff5548', // negro → fill coral
  outline: '#ff5548',
  ghost: 'transparent',
};

// Color de texto cuando el botón está cubierto en hover
const hoverTextMap: Record<Variant, string> = {
  primary: 'group-hover:text-neutral-50',   // texto blanco sobre negro
  secondary: 'group-hover:text-neutral-50', // texto blanco sobre coral
  outline: 'group-hover:text-neutral-50',
  ghost: 'group-hover:text-brand-coral',
};

const sizeMap: Record<Size, string> = {
  sm: 'h-10 pl-4 pr-1.5 text-sm',
  md: 'h-12 pl-5 pr-1.5 text-sm md:text-base',
  lg: 'h-14 pl-6 pr-2 text-base md:text-lg',
};
const sizeNoIcon: Record<Size, string> = {
  sm: 'h-10 px-5 text-sm',
  md: 'h-12 px-6 text-sm md:text-base',
  lg: 'h-14 px-8 text-base md:text-lg',
};

const circleSize: Record<Size, string> = {
  sm: 'h-7 w-7',
  md: 'h-9 w-9',
  lg: 'h-11 w-11',
};

const iconSize: Record<Size, string> = {
  sm: 'h-3.5 w-3.5',
  md: 'h-4 w-4',
  lg: 'h-5 w-5',
};

const hasIcon = !!iconRight;
const sizeClass = hasIcon ? sizeMap[size] : sizeNoIcon[size];
const surfaceClass = surfaceMap[variant];
const fillColor = fillMap[variant];
const hoverTextClass = hoverTextMap[variant];

const base =
  'btn group relative isolate inline-flex items-center justify-center gap-2 overflow-hidden rounded-full font-medium transition-colors duration-500 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50';

const allClass = [
  base,
  surfaceClass,
  sizeClass,
  hoverTextClass,
  hasIcon ? 'btn--with-circle' : variant !== 'ghost' && 'btn--with-radial',
  fullWidth && 'w-full',
  className,
];

const isLink = !!href;
const magnetic = variant === 'primary' || variant === 'secondary';
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;

const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';
---

{
  isLink ? (
    <a
      href={href}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      class:list={allClass}
      style={`--btn-ease: ${ease}; --btn-fill: ${fillColor}; --circle-r: 50%;`}
      data-smart-hover={magnetic ? '0.18' : undefined}
    >
      {/* FILL para variantes sin icono (radial desde cursor) */}
      {!hasIcon && variant !== 'ghost' && (
        <span class="btn-radial-fill" aria-hidden="true" />
      )}

      {iconLeft && (
        <Icon name={iconLeft} class:list={['btn-icon-left relative z-10', iconSize[size]]} />
      )}

      <span class="btn-label relative z-10 whitespace-nowrap">
        <slot />
      </span>

      {hasIcon && (
        <span
          class:list={['btn-circle-wrap relative ml-2 inline-flex flex-none items-center justify-center', circleSize[size]]}
        >
          {/* Disco que es el círculo y se expande */}
          <span class="btn-circle-disc absolute inset-0 rounded-full" aria-hidden="true" />
          {/* Icono con animación slide */}
          <span class:list={['btn-icon-track relative z-10 inline-flex items-center overflow-hidden', iconSize[size]]}>
            <Icon name={iconRight!} class:list={['shrink-0 text-neutral-50', iconSize[size]]} />
            <Icon name={iconRight!} class:list={['shrink-0 text-neutral-50', iconSize[size]]} />
          </span>
        </span>
      )}
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
      class:list={allClass}
      style={`--btn-ease: ${ease}; --btn-fill: ${fillColor};`}
      data-smart-hover={magnetic ? '0.18' : undefined}
    >
      {!hasIcon && variant !== 'ghost' && (
        <span class="btn-radial-fill" aria-hidden="true" />
      )}

      {iconLeft && (
        <Icon name={iconLeft} class:list={['btn-icon-left relative z-10', iconSize[size]]} />
      )}

      <span class="btn-label relative z-10 whitespace-nowrap">
        <slot />
      </span>

      {hasIcon && (
        <span
          class:list={['btn-circle-wrap relative ml-2 inline-flex flex-none items-center justify-center', circleSize[size]]}
        >
          <span class="btn-circle-disc absolute inset-0 rounded-full" aria-hidden="true" />
          <span class:list={['btn-icon-track relative z-10 inline-flex items-center overflow-hidden', iconSize[size]]}>
            <Icon name={iconRight!} class:list={['shrink-0 text-neutral-50', iconSize[size]]} />
            <Icon name={iconRight!} class:list={['shrink-0 text-neutral-50', iconSize[size]]} />
          </span>
        </span>
      )}
    </button>
  )
}

<style>
  .btn {
    transition-timing-function: var(--btn-ease);
  }

  /* ============================================================
     VARIANTE CON ICONO — disco coral/negro que se expande
     desde su posición original (derecha) hasta cubrir todo.
     ============================================================ */
  .btn--with-circle .btn-circle-disc {
    background: var(--btn-fill);
    transform: scale(1);
    transform-origin: center;
    transition: transform 0.8s var(--btn-ease);
    z-index: 0;
  }
  /* scale 30 garantiza cobertura aún en botones fullWidth/lg */
  .btn--with-circle:hover .btn-circle-disc {
    transform: scale(30);
  }

  /* Track de iconos: slide derecha y aparece otro por la izquierda */
  .btn--with-circle .btn-icon-track {
    width: 1em;
  }
  .btn--with-circle .btn-icon-track > :global(svg) {
    width: 1em;
    height: 1em;
    transform: translateX(0);
    transition: transform 0.6s var(--btn-ease);
  }
  .btn--with-circle .btn-icon-track > :global(svg:first-child) {
    margin-left: 0;
  }
  .btn--with-circle .btn-icon-track > :global(svg:nth-child(2)) {
    position: absolute;
    left: -100%;
    top: 0;
  }
  .btn--with-circle:hover .btn-icon-track > :global(svg:first-child) {
    transform: translateX(150%);
  }
  .btn--with-circle:hover .btn-icon-track > :global(svg:nth-child(2)) {
    transform: translateX(100%);
  }

  /* ============================================================
     VARIANTE SIN ICONO — radial fill desde posición del cursor
     ============================================================ */
  .btn--with-radial .btn-radial-fill {
    position: absolute;
    inset: 0;
    background: var(--btn-fill);
    clip-path: circle(0% at var(--mx, 50%) var(--my, 50%));
    transition: clip-path 0.7s var(--btn-ease);
    z-index: 0;
    pointer-events: none;
  }
  .btn--with-radial:hover .btn-radial-fill {
    clip-path: circle(150% at var(--mx, 50%) var(--my, 50%));
  }

  /* Asegurar label/icon arriba del fill */
  .btn .btn-label,
  .btn .btn-icon-left,
  .btn .btn-circle-wrap {
    position: relative;
    z-index: 10;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn-circle-disc,
    .btn-radial-fill,
    .btn-icon-track > :global(svg) {
      transition: none !important;
    }
  }
</style>

<script>
  // Track cursor entry/exit position for radial fill origin
  function initRadialOrigin() {
    document.querySelectorAll<HTMLElement>('.btn--with-radial').forEach((btn) => {
      if (btn.dataset.radialBound) return;
      btn.dataset.radialBound = '1';
      const setOrigin = (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        btn.style.setProperty('--mx', `${x}%`);
        btn.style.setProperty('--my', `${y}%`);
      };
      btn.addEventListener('mouseenter', setOrigin);
      btn.addEventListener('mouseleave', setOrigin);
    });
  }
  initRadialOrigin();
  // Re-run on Astro view transitions
  document.addEventListener('astro:page-load', initRadialOrigin);
</script>
