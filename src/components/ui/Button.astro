---
import { Icon } from 'astro-icon/components';

/**
 * Button — CTA premium con dos efectos según haya iconRight o no.
 *
 * CON iconRight (no-ghost):
 *   - Disco de color contraste a la derecha contiene el icono.
 *   - En hover, ese disco escala hasta cubrir el botón.
 *   - El icono se anima (slide tipo loop).
 *   - Texto SIEMPRE arriba del fill (z-index 10).
 *
 * SIN iconRight (no-ghost):
 *   - Radial clip-path expandiéndose DESDE la posición del cursor.
 *
 * Ghost (con o sin icono):
 *   - Sin fill. Icono inline + slide animado. Solo cambio de color de texto.
 *
 * Outline: border + texto = currentColor. Útil sobre fondos claros u oscuros.
 */

type Variant = 'primary' | 'secondary' | 'outline' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: '_blank' | '_self';
  iconLeft?: string;
  iconRight?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  target,
  iconLeft,
  iconRight,
  fullWidth = false,
  disabled = false,
  ariaLabel,
  class: className = '',
} = Astro.props as Props;

const surfaceMap: Record<Variant, string> = {
  primary: 'bg-brand-coral text-neutral-50',
  secondary: 'bg-brand-black text-neutral-50',
  // Hereda color del padre (light bg → black, dark bg → white)
  outline: 'border border-current bg-transparent text-current',
  ghost: 'bg-transparent text-current',
};

// Color del círculo (también del fill al expandir) — primary ahora con círculo BLANCO.
const fillMap: Record<Variant, string> = {
  primary: '#ffffff',
  secondary: '#ff5548',
  outline: '#ff5548',
  ghost: 'transparent',
};

// Color del icono dentro del círculo — coral en primary (sobre blanco),
// blanco en los otros (sobre coral/dark).
const iconInCircleClass: Record<Variant, string> = {
  primary: 'text-brand-coral',
  secondary: 'text-neutral-50',
  outline: 'text-neutral-50',
  ghost: 'text-current',
};

// Color de texto cuando el fill cubre el botón
const hoverTextMap: Record<Variant, string> = {
  primary: 'group-hover:text-brand-coral',  // fill blanco → texto coral
  secondary: 'group-hover:text-neutral-50', // fill coral → texto blanco
  outline: 'group-hover:text-neutral-50',
  ghost: 'group-hover:text-brand-coral',
};

const sizeMap: Record<Size, string> = {
  sm: 'h-10 pl-4 pr-2 text-sm',
  md: 'h-12 pl-5 pr-2.5 text-sm md:text-base',
  lg: 'h-14 pl-6 pr-3 text-base md:text-lg',
};
const sizeNoIcon: Record<Size, string> = {
  sm: 'h-10 px-5 text-sm',
  md: 'h-12 px-6 text-sm md:text-base',
  lg: 'h-14 px-8 text-base md:text-lg',
};
const sizeGhost: Record<Size, string> = {
  sm: 'h-10 px-3 text-sm',
  md: 'h-12 px-4 text-sm md:text-base',
  lg: 'h-14 px-5 text-base md:text-lg',
};

// Aire igual arriba/abajo/derecha (+2-4px extra para sensación premium):
// sm: btn h-10 (40), circle 24 → margen 8 → right 8.
// md: btn h-12 (48), circle 28 → margen 10 → right 10.
// lg: btn h-14 (56), circle 32 → margen 12 → right 12.
const circleSize: Record<Size, string> = {
  sm: 'h-6 w-6',
  md: 'h-7 w-7',
  lg: 'h-8 w-8',
};
const circleSizePx: Record<Size, number> = { sm: 24, md: 28, lg: 32 };
const circleRightPx: Record<Size, number> = { sm: 8, md: 10, lg: 12 };

const iconSize: Record<Size, string> = {
  sm: 'h-3.5 w-3.5',
  md: 'h-4 w-4',
  lg: 'h-5 w-5',
};

const hasIcon = !!iconRight;
const isGhost = variant === 'ghost';
const isCircleMode = hasIcon && !isGhost;
const isRadialMode = !hasIcon && !isGhost;

let sizeClass = sizeNoIcon[size];
if (isCircleMode) sizeClass = sizeMap[size];
if (isGhost) sizeClass = sizeGhost[size];

const surfaceClass = surfaceMap[variant];
const fillColor = fillMap[variant];
const hoverTextClass = hoverTextMap[variant];

const base =
  'btn group relative isolate inline-flex items-center justify-center gap-2 overflow-hidden rounded-full font-medium transition-colors duration-700 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50';

const allClass = [
  base,
  surfaceClass,
  sizeClass,
  hoverTextClass,
  `btn--variant-${variant}`,
  isCircleMode && 'btn--circle',
  isRadialMode && 'btn--radial',
  isGhost && 'btn--ghost',
  fullWidth && 'w-full',
  className,
];

const isLink = !!href;
const magnetic = variant === 'primary' || variant === 'secondary';
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;

// Ease in-out simétrico: fill-in y fill-out se perciben igual de rápidos.
const ease = 'cubic-bezier(0.65, 0, 0.35, 1)';
const cz = circleSizePx[size];
const cr = circleRightPx[size];

const styleVars = `--btn-ease: ${ease}; --btn-fill: ${fillColor}; --btn-circle-size: ${cz}px; --btn-circle-right: ${cr}px;`;
---

{
  isLink ? (
    <a
      href={href}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      class:list={allClass}
      style={styleVars}
      data-smart-hover={magnetic ? '0.18' : undefined}
    >
      {/* FILL — disco circle-mode O radial cursor-mode */}
      {(isCircleMode || isRadialMode) && (
        <span class="btn-fill" aria-hidden="true" />
      )}

      {iconLeft && (
        <Icon name={iconLeft} class:list={['btn-icon-side relative z-10', iconSize[size]]} />
      )}

      <span class="btn-label relative z-10 whitespace-nowrap">
        <slot />
      </span>

      {/* CIRCLE-MODE: icono dentro del área del disco */}
      {isCircleMode && (
        <span
          class:list={['btn-icon-anchor relative z-10 ml-2 inline-flex flex-none items-center justify-center overflow-hidden rounded-full', circleSize[size]]}
        >
          <span class:list={['btn-icon-track relative inline-flex items-center overflow-hidden', iconSize[size]]}>
            <Icon name={iconRight!} class:list={['shrink-0', iconInCircleClass[variant], iconSize[size]]} />
            <Icon name={iconRight!} class:list={['shrink-0 btn-icon-clone', iconInCircleClass[variant], iconSize[size]]} />
          </span>
        </span>
      )}

      {/* GHOST con icono: solo icono inline animado */}
      {isGhost && hasIcon && (
        <span class:list={['btn-icon-ghost relative z-10 inline-flex items-center overflow-hidden', iconSize[size]]}>
          <Icon name={iconRight!} class:list={['shrink-0', iconSize[size]]} />
          <Icon name={iconRight!} class:list={['shrink-0 btn-icon-clone', iconSize[size]]} />
        </span>
      )}
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
      class:list={allClass}
      style={styleVars}
      data-smart-hover={magnetic ? '0.18' : undefined}
    >
      {(isCircleMode || isRadialMode) && (
        <span class="btn-fill" aria-hidden="true" />
      )}

      {iconLeft && (
        <Icon name={iconLeft} class:list={['btn-icon-side relative z-10', iconSize[size]]} />
      )}

      <span class="btn-label relative z-10 whitespace-nowrap">
        <slot />
      </span>

      {isCircleMode && (
        <span
          class:list={['btn-icon-anchor relative z-10 ml-2 inline-flex flex-none items-center justify-center overflow-hidden rounded-full', circleSize[size]]}
        >
          <span class:list={['btn-icon-track relative inline-flex items-center overflow-hidden', iconSize[size]]}>
            <Icon name={iconRight!} class:list={['shrink-0', iconInCircleClass[variant], iconSize[size]]} />
            <Icon name={iconRight!} class:list={['shrink-0 btn-icon-clone', iconInCircleClass[variant], iconSize[size]]} />
          </span>
        </span>
      )}

      {isGhost && hasIcon && (
        <span class:list={['btn-icon-ghost relative z-10 inline-flex items-center overflow-hidden', iconSize[size]]}>
          <Icon name={iconRight!} class:list={['shrink-0', iconSize[size]]} />
          <Icon name={iconRight!} class:list={['shrink-0 btn-icon-clone', iconSize[size]]} />
        </span>
      )}
    </button>
  )
}

<style>
  .btn {
    transition-timing-function: var(--btn-ease);
    transition-property: color, background-color, box-shadow;
    transition-duration: 0.5s;
  }

  /* Primary: cuando el fill blanco cubre el botón, agregamos sombra para
     distinguirlo de fondos claros. */
  .btn--variant-primary {
    box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
  }
  .btn--variant-primary:hover,
  .btn--variant-primary:focus-visible {
    box-shadow: 0 10px 28px rgba(10, 10, 10, 0.18), 0 2px 6px rgba(10, 10, 10, 0.08);
  }

  /* Color de label explícito por estado en primary — evita contrast issues con
     la utility class de Tailwind. Coral más profundo en hover para legibilidad. */
  .btn--variant-primary .btn-label {
    color: #ffffff;
    font-weight: 600;
    transition: color 0.5s var(--btn-ease);
  }
  .btn--variant-primary:hover .btn-label,
  .btn--variant-primary:focus-visible .btn-label {
    color: #e8463a; /* coral con mejor contraste sobre blanco (~4.6:1) */
  }

  /* ============================================================
     CIRCLE MODE — el span.btn-fill es el disco visible y el que se expande.
     Posicionado absolute donde estaría el círculo (derecha), tamaño exacto.
     z-index 1 (siempre debajo de label y icon-anchor que son z-10).
     ============================================================ */
  .btn--circle .btn-fill {
    position: absolute;
    top: 50%;
    right: var(--btn-circle-right);
    width: var(--btn-circle-size);
    height: var(--btn-circle-size);
    margin-top: calc(var(--btn-circle-size) / -2);
    border-radius: 9999px;
    background: var(--btn-fill);
    transform: scale(1);
    transform-origin: center;
    transition: transform 1s var(--btn-ease);
    z-index: 1;
    pointer-events: none;
  }
  .btn--circle:hover .btn-fill,
  .btn--circle:focus-visible .btn-fill {
    transform: scale(30);
  }

  /* Track de iconos para circle-mode: ancho = un icono, contiene clone shift */
  .btn--circle .btn-icon-track {
    width: 1em;
    height: 1em;
  }
  .btn--circle .btn-icon-track > :global(svg) {
    transition: transform 0.7s var(--btn-ease);
  }
  .btn--circle .btn-icon-track > :global(svg.btn-icon-clone) {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateX(-130%);
  }
  .btn--circle:hover .btn-icon-track > :global(svg:not(.btn-icon-clone)),
  .btn--circle:focus-visible .btn-icon-track > :global(svg:not(.btn-icon-clone)) {
    transform: translateX(130%);
  }
  .btn--circle:hover .btn-icon-track > :global(svg.btn-icon-clone),
  .btn--circle:focus-visible .btn-icon-track > :global(svg.btn-icon-clone) {
    transform: translateX(0);
  }

  /* ============================================================
     RADIAL MODE — sin icono. Clip-path desde el cursor.
     ============================================================ */
  .btn--radial .btn-fill {
    position: absolute;
    inset: 0;
    background: var(--btn-fill);
    clip-path: circle(0% at var(--mx, 50%) var(--my, 50%));
    transition: clip-path 0.9s var(--btn-ease);
    z-index: 1;
    pointer-events: none;
  }
  .btn--radial:hover .btn-fill,
  .btn--radial:focus-visible .btn-fill {
    clip-path: circle(150% at var(--mx, 50%) var(--my, 50%));
  }

  /* ============================================================
     GHOST — solo icono slide, sin fill
     ============================================================ */
  .btn--ghost .btn-icon-ghost {
    width: 1em;
    height: 1em;
    position: relative;
  }
  .btn--ghost .btn-icon-ghost > :global(svg) {
    transition: transform 0.6s var(--btn-ease);
  }
  .btn--ghost .btn-icon-ghost > :global(svg.btn-icon-clone) {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateX(-130%);
  }
  .btn--ghost:hover .btn-icon-ghost > :global(svg:not(.btn-icon-clone)) {
    transform: translateX(130%);
  }
  .btn--ghost:hover .btn-icon-ghost > :global(svg.btn-icon-clone) {
    transform: translateX(0);
  }

  /* ============================================================
     Z-stack — todo el contenido por arriba del fill
     ============================================================ */
  .btn .btn-label,
  .btn .btn-icon-side,
  .btn .btn-icon-anchor,
  .btn .btn-icon-ghost {
    position: relative;
    z-index: 10;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn-fill,
    .btn-icon-track > :global(svg),
    .btn-icon-ghost > :global(svg) {
      transition: none !important;
    }
  }
</style>

<script>
  function initRadial() {
    document.querySelectorAll<HTMLElement>('.btn--radial').forEach((btn) => {
      if (btn.dataset.radialBound) return;
      btn.dataset.radialBound = '1';
      const setOrigin = (e: MouseEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        btn.style.setProperty('--mx', `${x}%`);
        btn.style.setProperty('--my', `${y}%`);
      };
      btn.addEventListener('mouseenter', setOrigin);
      btn.addEventListener('mouseleave', setOrigin);
    });
  }
  initRadial();
  document.addEventListener('astro:page-load', initRadial);
</script>
