---
import { Icon } from 'astro-icon/components';

/**
 * Button — Primary CTA con animaciones premium.
 *
 * Cuando se pasa `iconRight`, el icono vive dentro de un círculo de color
 * contraste alineado a la derecha del botón. En hover, ese círculo se expande
 * orgánicamente con un ease premium (cubic-bezier expo-out) hasta cubrir el
 * botón completo, invirtiendo los colores. Sin icono → fill suave bottom-up.
 *
 * Variantes:
 * - primary:   coral + círculo negro → en hover el círculo cubre todo (negro)
 * - secondary: negro + círculo coral → en hover el círculo cubre todo (coral)
 * - outline:   transparente + círculo coral → en hover el círculo cubre todo (coral)
 * - ghost:     transparente, sin fill, solo cambio de color de texto
 */

type Variant = 'primary' | 'secondary' | 'outline' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: '_blank' | '_self';
  iconLeft?: string;
  iconRight?: string;
  fullWidth?: boolean;
  disabled?: boolean;
  ariaLabel?: string;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  target,
  iconLeft,
  iconRight,
  fullWidth = false,
  disabled = false,
  ariaLabel,
  class: className = '',
} = Astro.props as Props;

// Color de SUPERFICIE base (lo que ve idle)
const surfaceMap: Record<Variant, string> = {
  primary: 'bg-brand-coral text-neutral-50',
  secondary: 'bg-brand-black text-neutral-50',
  outline: 'border border-current bg-transparent text-brand-black',
  ghost: 'bg-transparent text-current',
};

// Color del CÍRCULO que contiene el icono (contraste con la superficie)
// También es el color que cubrirá el botón al expandirse.
const circleMap: Record<Variant, string> = {
  primary: 'bg-brand-black',   // coral → círculo negro
  secondary: 'bg-brand-coral', // negro → círculo coral
  outline: 'bg-brand-coral',   // outline → círculo coral
  ghost: 'bg-brand-coral',
};

// Color de texto cuando el botón está completamente cubierto (hover final)
const hoverTextMap: Record<Variant, string> = {
  primary: 'group-hover:text-neutral-50',   // black bg → white text
  secondary: 'group-hover:text-neutral-50', // coral bg → white text
  outline: 'group-hover:text-neutral-50',
  ghost: 'group-hover:text-brand-coral',    // ghost: solo cambio de color
};

// Sizing — espacio extra a la derecha para alojar el círculo del icono
const sizeMap: Record<Size, string> = {
  sm: 'h-10 pl-4 pr-2 text-sm',
  md: 'h-12 pl-5 pr-2 text-sm md:text-base',
  lg: 'h-14 pl-6 pr-3 text-base md:text-lg',
};
// Para botones sin icono usamos padding uniforme
const sizeNoIcon: Record<Size, string> = {
  sm: 'h-10 px-4 text-sm',
  md: 'h-12 px-5 text-sm md:text-base',
  lg: 'h-14 px-7 text-base md:text-lg',
};

// Tamaño del círculo (cabe dentro del alto del botón con margen)
const circleSize: Record<Size, string> = {
  sm: 'h-7 w-7',
  md: 'h-9 w-9',
  lg: 'h-11 w-11',
};

const iconSize: Record<Size, string> = {
  sm: 'h-3.5 w-3.5',
  md: 'h-4 w-4',
  lg: 'h-5 w-5',
};

const hasIcon = !!iconRight;
const sizeClass = hasIcon ? sizeMap[size] : sizeNoIcon[size];
const surfaceClass = surfaceMap[variant];
const circleColorClass = circleMap[variant];
const hoverTextClass = hoverTextMap[variant];

const base =
  'btn group relative isolate inline-flex items-center justify-center gap-2 overflow-hidden rounded-full font-medium transition-colors duration-500 focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50';

const allClass = [
  base,
  surfaceClass,
  sizeClass,
  hoverTextClass,
  hasIcon && 'btn--with-circle',
  variant === 'ghost' && 'btn--ghost',
  fullWidth && 'w-full',
  className,
];

const isLink = !!href;
const magnetic = variant === 'primary' || variant === 'secondary';
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;

// Premium organic ease — expo.out, sensación de fluido decelerando
const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';

const ContentTag = isLink ? 'a' : 'button';
---

{
  isLink ? (
    <a
      href={href}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
      class:list={allClass}
      style={`--btn-ease: ${ease}`}
      data-smart-hover={magnetic ? '0.18' : undefined}
    >
      {iconLeft && (
        <Icon name={iconLeft} class:list={['btn-icon-left relative z-10', iconSize[size]]} />
      )}
      <span class="btn-label relative z-10 whitespace-nowrap">
        <slot />
      </span>
      {hasIcon && (
        <span
          class:list={[
            'btn-circle relative z-10 ml-2 inline-flex flex-none items-center justify-center rounded-full transition-colors duration-500',
            circleSize[size],
            circleColorClass,
          ]}
          aria-hidden="true"
        >
          <Icon name={iconRight!} class:list={['relative z-10 text-neutral-50', iconSize[size]]} />
        </span>
      )}
    </a>
  ) : (
    <button
      type={type}
      disabled={disabled}
      aria-label={ariaLabel}
      class:list={allClass}
      style={`--btn-ease: ${ease}`}
      data-smart-hover={magnetic ? '0.18' : undefined}
    >
      {iconLeft && (
        <Icon name={iconLeft} class:list={['btn-icon-left relative z-10', iconSize[size]]} />
      )}
      <span class="btn-label relative z-10 whitespace-nowrap">
        <slot />
      </span>
      {hasIcon && (
        <span
          class:list={[
            'btn-circle relative z-10 ml-2 inline-flex flex-none items-center justify-center rounded-full transition-colors duration-500',
            circleSize[size],
            circleColorClass,
          ]}
          aria-hidden="true"
        >
          <Icon name={iconRight!} class:list={['relative z-10 text-neutral-50', iconSize[size]]} />
        </span>
      )}
    </button>
  )
}

<style>
  .btn {
    transition-timing-function: var(--btn-ease);
  }

  /* ============================================================
     EFECTO 1 — Botón CON círculo (iconRight)
     El ::after del círculo crece hasta cubrir todo el botón.
     ============================================================ */
  .btn--with-circle .btn-circle {
    position: relative;
  }
  .btn--with-circle .btn-circle::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: inherit;
    transform: scale(1);
    transform-origin: center;
    transition: transform 0.7s var(--btn-ease);
    z-index: 0;
  }
  /* En hover el pseudo-círculo escala hasta cubrir todo el botón.
     scale(20) es generoso: garantiza cobertura aun en btn lg/fullWidth */
  .btn--with-circle:hover .btn-circle::before {
    transform: scale(22);
  }

  /* ============================================================
     EFECTO 2 — Botón SIN círculo (fill orgánico bottom-up)
     Pseudo con curva SVG en el borde superior, sube en hover.
     ============================================================ */
  .btn:not(.btn--with-circle):not(.btn--ghost)::before {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: 0;
    height: 120%;
    background: currentColor;
    /* máscara con curva orgánica en el borde superior */
    -webkit-mask-image: radial-gradient(120% 100% at 50% 100%, black 65%, transparent 66%);
            mask-image: radial-gradient(120% 100% at 50% 100%, black 65%, transparent 66%);
    transform: translateY(105%);
    transition: transform 0.8s var(--btn-ease);
    z-index: -1;
    opacity: 0.001; /* fix para iOS safari */
  }
  .btn:not(.btn--with-circle):not(.btn--ghost):hover::before {
    transform: translateY(0);
    opacity: 1;
  }
  /* Color del fill por variante (currentColor inherita del color de texto fallback) */
  .btn.bg-brand-coral:not(.btn--with-circle)::before { background: #0a0a0a; }
  .btn.bg-brand-black:not(.btn--with-circle)::before { background: #ff5548; }
  .btn.bg-transparent:not(.btn--with-circle):not(.btn--ghost)::before { background: #ff5548; }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn-circle::before,
    .btn::before {
      transition: none !important;
    }
  }
</style>
