---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/nav/Footer.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import Analytics from '../components/analytics/Analytics.astro';
import GTMNoscript from '../components/analytics/GTMNoscript.astro';
import SmartHover from '../components/fx/SmartHover.astro';
import GlowHover from '../components/fx/GlowHover.astro';
import MotionTilt from '../components/fx/MotionTilt.astro';
import SplitTextReveal from '../components/fx/SplitTextReveal.astro';
import { organizationSchema, websiteSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Override absolute canonical (defaults to current URL). */
  canonical?: string;
  /** Open Graph image (absolute URL or path relative to site). */
  ogImage?: string;
  /** Additional Schema.org JSON-LD blocks for this specific page. */
  schemas?: Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  schemas = [],
} = Astro.props as Props;

// Global schemas (Organization + WebSite) on every page + page-specific extras
const allSchemas = [organizationSchema(), websiteSchema(), ...schemas];

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://lucsandesign.com').toString();
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site ?? 'https://lucsandesign.com').toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Favicon */}
    <link rel="icon" href="/brand/Simbolo-coral.svg" type="image/svg+xml" />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Lucsan Design" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Schema.org JSON-LD */}
    <SchemaOrg schemas={allSchemas} />

    {/* Analytics (GTM + GA4 fallback + Meta Pixel) — prod only */}
    <Analytics />

    {/* Astro View Transitions — smooth client-side navigation */}
    <ClientRouter />

    {/* Animations (Lenis smooth scroll + GSAP reveals) — respects reduced-motion */}
    <script>
      import '../scripts/animations';
    </script>

    {/* Preload critical fonts (LCP candidates) */}
    <link
      rel="preload"
      href="/fonts/CabinetGrotesk-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Switzer-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body class="min-h-screen bg-brand-black text-brand-black antialiased">
    {/* GTM noscript fallback — must be immediately after <body> */}
    <GTMNoscript />

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-black focus:px-4 focus:py-2 focus:text-neutral-50"
    >
      Saltar al contenido
    </a>

    {/* Page layer — encima del footer, con bg sólido. Margin-bottom = footer-height crea
        el espacio scrolleable que revela el footer al final. */}
    <div id="page-layer" class="page-layer relative z-10 bg-neutral-50">
      <Navbar />

      <main id="main-content">
        <slot />
      </main>
    </div>

    {/* Footer FIJO al fondo del viewport, detrás del page-layer (z-0).
        Se revela cuando el page-layer scrollea hacia arriba. */}
    <Footer />

    {/* SmartHover utility — efecto magnético en cualquier elemento con [data-smart-hover] */}
    <SmartHover />

    {/* GlowHover utility — radial-gradient coral siguiendo el cursor en [data-glow-hover] */}
    <GlowHover />

    {/* MotionTilt utility — 3D tilt en [data-tilt] (Cards con href, etc.) */}
    <MotionTilt />

    {/* SplitTextReveal utility — split por palabras + stagger reveal en [data-split-words] */}
    <SplitTextReveal />

    <style is:global>
      /* === Footer reveal effect ===
         Footer fixed al fondo del viewport (z-0). El page-layer (z-10) tiene bg sólido
         que lo cubre. Margin-bottom del page-layer crea espacio scrolleable que revela
         el footer al final. */
      .site-footer {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 0;
        width: 100%;
      }
      .page-layer {
        /* margin-bottom seteado por JS en función del alto real del footer */
        margin-bottom: var(--footer-h, 600px);
      }
      @media (prefers-reduced-motion: reduce) {
        .site-footer { position: relative; }
        .page-layer { margin-bottom: 0; }
      }
    </style>

    <script>
      // Mide el alto real del footer y lo expone como CSS var → page-layer reserva
      // ese espacio scrolleable al final. Refresca en resize y page-load.
      function syncFooterHeight() {
        const footer = document.getElementById('site-footer');
        if (!footer) return;
        const h = footer.offsetHeight;
        document.documentElement.style.setProperty('--footer-h', `${h}px`);
      }
      syncFooterHeight();
      window.addEventListener('resize', syncFooterHeight, { passive: true });
      document.addEventListener('astro:page-load', syncFooterHeight);
      // Re-medir cuando fonts cargan (cambia layout)
      if ('fonts' in document) {
        document.fonts.ready.then(syncFooterHeight);
      }
    </script>
  </body>
</html>
