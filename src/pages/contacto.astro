---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Prose from '../components/ui/Prose.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { Icon } from 'astro-icon/components';

const entry = await getEntry('pages', 'contacto');
if (!entry || entry.data.tipo !== 'contacto') {
  throw new Error('Contacto content not found in src/content/pages/contacto.json');
}
const c = entry.data;

const whatsappUrl = `https://wa.me/${c.whatsapp.numero.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(c.whatsapp.mensajePreLlenado)}`;
---

<BaseLayout title={c.seo.title} description={c.seo.description}>
  {/* HERO — light */}
  <Section surface="page" spacing="none" class="relative pt-32 pb-12 md:pt-44 md:pb-20">
    <Container>
      <Eyebrow>Contacto</Eyebrow>
      <Heading level={1} size="3xl" class="mt-6 max-w-4xl">
        {c.headline}
      </Heading>
      <Prose tone="secondary" size="xl" class="mt-8 max-w-2xl">
        {c.subhead}
      </Prose>
      <p class="mt-6 inline-flex items-center gap-2 text-sm text-text-muted">
        <Icon name="ph:clock-bold" class="h-4 w-4 text-text-accent" />
        {c.tiempoRespuesta}
      </p>
    </Container>
  </Section>

  {/* FORM + CANALES DIRECTOS */}
  <Section surface="page" spacing="base">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
        {/* Form placeholder — built in T12 */}
        <Card variant="elevated" padding="lg" radius="xl">
          <Heading level={2} size="md">Cuéntanos los detalles</Heading>
          <Prose tone="secondary" class="mt-3">
            Compartí qué necesitás y un par de líneas sobre tu proyecto. Te respondemos en menos de 24 horas hábiles.
          </Prose>

          <form class="mt-8 flex flex-col gap-5" action="/api/contact" method="POST">
            <div class="grid gap-5 md:grid-cols-2">
              <label class="flex flex-col gap-2 text-sm">
                <span class="font-medium">Nombre</span>
                <input
                  type="text"
                  name="nombre"
                  required
                  autocomplete="name"
                  class="rounded-md border border-border-default bg-surface-page px-4 py-3 text-base focus:border-border-accent focus:outline-none"
                  placeholder="Tu nombre"
                />
              </label>
              <label class="flex flex-col gap-2 text-sm">
                <span class="font-medium">Email</span>
                <input
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="rounded-md border border-border-default bg-surface-page px-4 py-3 text-base focus:border-border-accent focus:outline-none"
                  placeholder="tu@correo.com"
                />
              </label>
            </div>

            <label class="flex flex-col gap-2 text-sm">
              <span class="font-medium">Empresa <span class="text-text-muted">(opcional)</span></span>
              <input
                type="text"
                name="empresa"
                autocomplete="organization"
                class="rounded-md border border-border-default bg-surface-page px-4 py-3 text-base focus:border-border-accent focus:outline-none"
                placeholder="Nombre de tu empresa"
              />
            </label>

            <label class="flex flex-col gap-2 text-sm">
              <span class="font-medium">¿En qué te podemos ayudar?</span>
              <select
                name="servicio"
                required
                class="rounded-md border border-border-default bg-surface-page px-4 py-3 text-base focus:border-border-accent focus:outline-none"
              >
                <option value="">Elegí un servicio</option>
                <option value="branding">Branding y diseño de marca</option>
                <option value="diseno-web">Diseño web</option>
                <option value="marketing-digital">Marketing digital</option>
                <option value="otro">Otro / no estoy seguro</option>
              </select>
            </label>

            <label class="flex flex-col gap-2 text-sm">
              <span class="font-medium">Presupuesto aproximado <span class="text-text-muted">(opcional)</span></span>
              <select
                name="presupuesto"
                class="rounded-md border border-border-default bg-surface-page px-4 py-3 text-base focus:border-border-accent focus:outline-none"
              >
                <option value="">No estoy seguro</option>
                {c.rangosPresupuesto.map((r) => <option value={r}>{r}</option>)}
              </select>
            </label>

            <label class="flex flex-col gap-2 text-sm">
              <span class="font-medium">Contanos sobre el proyecto</span>
              <textarea
                name="mensaje"
                required
                rows={5}
                class="rounded-md border border-border-default bg-surface-page px-4 py-3 text-base focus:border-border-accent focus:outline-none"
                placeholder="Objetivo, plazo aproximado, contexto relevante…"
              />
            </label>

            <div class="mt-2 flex items-center justify-between gap-4">
              <p class="text-xs text-text-muted">
                Al enviar aceptás nuestra <a href="/legal/privacidad" class="underline hover:text-text-accent">política de privacidad</a>.
              </p>
              <Button type="submit" variant="primary" iconRight="ph:arrow-right-bold" disabled>
                Enviar mensaje
              </Button>
            </div>

            <p class="text-xs italic text-text-muted">
              Form en construcción — por ahora escribinos por WhatsApp o email.
            </p>
          </form>
        </Card>

        {/* Canales directos */}
        <div class="flex flex-col gap-4">
          <Card variant="inverse" padding="lg" radius="xl">
            <Icon name="ph:whatsapp-logo-bold" class="h-10 w-10 text-text-accent" />
            <Heading level={3} size="md" tone="inverse" class="mt-4">WhatsApp</Heading>
            <Prose tone="inverse-secondary" class="mt-2">
              La forma más rápida de empezar la conversación.
            </Prose>
            <div class="mt-6">
              <Button href={whatsappUrl} target="_blank" variant="primary" iconRight="ph:arrow-up-right-bold">
                Abrir WhatsApp
              </Button>
            </div>
          </Card>

          <Card variant="default" padding="lg" radius="xl">
            <Icon name="ph:envelope-simple-bold" class="h-10 w-10 text-text-accent" />
            <Heading level={3} size="md" class="mt-4">Email</Heading>
            <Prose tone="secondary" class="mt-2">
              Si preferís dejar el contexto escrito antes de la primera reunión.
            </Prose>
            <a
              href={`mailto:${c.email}`}
              class="mt-6 inline-flex items-center gap-2 font-medium text-text-primary transition-colors hover:text-text-accent"
            >
              {c.email}
              <Icon name="ph:arrow-up-right-bold" class="h-4 w-4" />
            </a>
          </Card>

          <Card variant="filled" padding="lg" radius="xl">
            <Icon name="ph:map-pin-bold" class="h-10 w-10 text-text-accent" />
            <Heading level={3} size="md" class="mt-4">Dónde estamos</Heading>
            <Prose tone="secondary" class="mt-2">
              Santiago, Chile. Trabajamos en remoto con clientes en toda Latinoamérica.
            </Prose>
          </Card>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
