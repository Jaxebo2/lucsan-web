---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Heading from '../../components/ui/Heading.astro';
import Prose from '../../components/ui/Prose.astro';
import Card from '../../components/ui/Card.astro';
import CTABlock from '../../components/ui/CTABlock.astro';
import { Icon } from 'astro-icon/components';

const services = (await getCollection('services', (s) => s.data.publicado))
  .sort((a, b) => a.data.orden - b.data.orden);

const iconForService: Record<string, string> = {
  branding: 'ph:target-bold',
  'diseno-web': 'ph:browsers-bold',
  'marketing-digital': 'ph:trend-up-bold',
  'identidad-visual': 'ph:palette-bold',
  'rediseno-de-marca': 'ph:arrows-clockwise-bold',
  'estrategia-de-marca': 'ph:strategy-bold',
  'diseno-ux-ui': 'ph:cursor-bold',
  'contenido-redes-sociales': 'ph:megaphone-bold',
};

const seoTitle = 'Servicios de diseño, branding y marketing — Lucsan Design';
const seoDescription =
  'Estudio chileno especializado en branding, diseño web y marketing digital. Cada servicio con método claro, entregables definidos y resultados medibles.';
---

<BaseLayout title={seoTitle} description={seoDescription}>
  {/* HERO — dark */}
  <Section surface="inverse" spacing="none" class="relative pt-32 pb-20 md:pt-44 md:pb-28">
    <Container>
      <Eyebrow tone="inverse">Servicios</Eyebrow>
      <Heading level={1} size="3xl" tone="inverse" class="mt-6 max-w-5xl">
        Tres disciplinas, <span class="text-text-accent">un solo método</span>.
      </Heading>
      <Prose tone="inverse-secondary" size="xl" class="mt-8 max-w-3xl">
        Branding, diseño web y marketing digital integrados. Cada servicio resuelve un problema de
        negocio específico, con entregables claros y métricas que importan.
      </Prose>
    </Container>
  </Section>

  {/* GRID — light */}
  <Section surface="page">
    <Container>
      {
        services.length === 0 ? (
          <Prose tone="secondary" size="lg">
            Aún no hay servicios publicados.
          </Prose>
        ) : (
          <div class="grid gap-6 md:grid-cols-2">
            {services.map((s) => (
              <Card href={`/servicios/${s.data.slug}`} variant="default" padding="lg" radius="xl">
                <Icon
                  name={iconForService[s.data.slug] ?? 'ph:sparkle-bold'}
                  class="h-12 w-12 text-text-accent"
                />
                <Heading level={2} size="md" class="mt-6">{s.data.title}</Heading>
                <Prose tone="secondary" size="base" class="mt-3">{s.data.hero.subhead}</Prose>
                <span class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-text-primary transition-colors group-hover:text-text-accent">
                  Ver servicio
                  <Icon name="ph:arrow-right-bold" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </Card>
            ))}
          </div>
        )
      }
    </Container>
  </Section>

  {/* CTA — final */}
  <Section surface="page" spacing="base">
    <Container>
      <CTABlock
        eyebrow="¿No estás seguro?"
        headline="Conversemos y te decimos qué necesitas."
        primaryCta={{ texto: 'Conversemos', href: '/contacto' }}
        surface="inverse"
      />
    </Container>
  </Section>
</BaseLayout>
