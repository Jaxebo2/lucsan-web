---
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Heading from '../../components/ui/Heading.astro';
import Prose from '../../components/ui/Prose.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import MotionFAQ from '../../components/fx/MotionFAQ.tsx';
import CTABlock from '../../components/ui/CTABlock.astro';
import MediaSlot from '../../components/ui/MediaSlot.astro';
import HeroFluid from '../../components/fx/HeroFluid.astro';
import MotionAccordion from '../../components/fx/MotionAccordion.tsx';
import { Icon } from 'astro-icon/components';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const services = await getCollection('services', (s) => s.data.publicado);
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const s = service.data;

const proyectosRelacionados = s.casosRelacionados.length > 0
  ? await getEntries(s.casosRelacionados)
  : [];

const schemas = [
  serviceSchema({ name: s.title, description: s.seo.description, slug: s.slug }),
  breadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Servicios', url: '/servicios' },
    { name: s.title, url: `/servicios/${s.slug}` },
  ]),
  faqSchema(s.faq),
];
---

<BaseLayout title={s.seo.title} description={s.seo.description} ogImage={s.seo.ogImage} schemas={schemas}>
  {/* HERO — dark */}
  <Section surface="inverse" spacing="none" class="relative overflow-hidden pt-32 pb-20 md:pt-44 md:pb-28">
    <HeroFluid variant="dark" intensity={0.85} />
    <Container class="relative z-10">
      <p class="text-sm text-text-inverse-secondary">
        <a href="/servicios" class="hover:text-text-accent">Servicios</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-text-inverse">{s.title}</span>
      </p>
      <Eyebrow tone="inverse" class="mt-8">{s.title}</Eyebrow>
      <Heading level={1} size="3xl" tone="inverse" class="mt-6 max-w-5xl">
        {s.hero.headline}
      </Heading>
      <Prose tone="inverse-secondary" size="xl" class="mt-8 max-w-3xl">
        {s.hero.subhead}
      </Prose>
      <div class="mt-12 flex flex-wrap gap-4">
        <Button href="/contacto" variant="primary" iconRight="ph:arrow-right-bold">
          Conversemos
        </Button>
        <Button href="#metodo" variant="outline">
          Ver método
        </Button>
      </div>
    </Container>
  </Section>

  {/* QUÉ INCLUYE — light */}
  <Section surface="page">
    <Container>
      <Eyebrow>Qué incluye este servicio</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
        Todas las <span class="text-text-accent">disciplinas</span> que cubrimos.
      </Heading>

      <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {
          s.incluye.map((item) => (
            <Card variant="filled" padding="lg" radius="xl">
              <Icon name="ph:check-bold" class="h-6 w-6 text-text-accent" />
              <Heading level={3} size="sm" class="mt-4">{item.titulo}</Heading>
              {item.descripcion && (
                <Prose tone="secondary" size="sm" class="mt-3">{item.descripcion}</Prose>
              )}
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* PARA QUIÉN — muted */}
  <Section surface="muted">
    <Container>
      <Eyebrow>Para quién</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
        ¿Te suena <span class="text-text-accent">familiar</span>?
      </Heading>

      <div class="mt-16" data-reveal>
        <MotionAccordion
          client:visible
          panels={s.paraQuien.map((p) => ({
            titulo: p.perfil,
            descripcion: p.descripcion,
          }))}
        />
      </div>
    </Container>
  </Section>

  {/* PROBLEMA — light */}
  <Section surface="page">
    <Container size="md">
      <Eyebrow>El problema</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3">
        {s.problema.titulo}
      </Heading>

      <ul class="mt-12 flex flex-col gap-4">
        {
          s.problema.sintomas.map((sintoma) => (
            <li class="flex items-start gap-4 border-b border-border-subtle pb-4 last:border-b-0">
              <Icon name="ph:warning-circle-bold" class="mt-1 h-6 w-6 flex-none text-text-accent" />
              <span class="text-lg text-text-primary md:text-xl">{sintoma}</span>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  {/* MÉTODO — dark */}
  <Section surface="inverse" id="metodo">
    <Container>
      <Eyebrow tone="inverse">Cómo trabajamos</Eyebrow>
      <Heading level={2} size="2xl" tone="inverse" class="mt-3 max-w-3xl">
        El proceso, <span class="text-text-accent">paso a paso</span>.
      </Heading>

      <div
        class:list={[
          'mt-16 grid gap-8',
          s.metodo.length === 3 && 'md:grid-cols-3',
          s.metodo.length === 4 && 'md:grid-cols-2 lg:grid-cols-4',
          s.metodo.length !== 3 && s.metodo.length !== 4 && 'md:grid-cols-2',
        ]}
      >
        {
          s.metodo.map((fase, i) => (
            <Card variant="inverse" padding="lg" radius="xl">
              <span class="font-display text-3xl font-bold text-text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Heading level={3} size="md" tone="inverse" class="mt-4">
                {fase.fase.replace(/^\d+\.\s*/, '')}
              </Heading>
              <Prose tone="inverse-secondary" class="mt-3">{fase.descripcion}</Prose>
              <ul class="mt-6 flex flex-col gap-2">
                {fase.entregables.map((e) => (
                  <li class="flex items-start gap-2 text-sm text-text-inverse-secondary">
                    <Icon name="ph:check-bold" class="mt-1 h-4 w-4 flex-none text-text-accent" />
                    <span>{e}</span>
                  </li>
                ))}
              </ul>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* FRAMEWORKS — light (opcional) */}
  {
    s.frameworks.length > 0 && (
      <Section surface="page">
        <Container>
          <Eyebrow>Frameworks que usamos</Eyebrow>
          <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
            Las <span class="text-text-accent">herramientas</span> detrás de cada decisión.
          </Heading>
          <Prose tone="secondary" size="lg" class="mt-6 max-w-2xl">
            Nada es improvisado. Trabajamos con modelos validados que estructuran cómo entendemos
            tu marca, tu mercado y tu cliente.
          </Prose>

          <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
            {s.frameworks.map((fw) => (
              <Card variant="filled" padding="lg" radius="xl">
                <Icon name="ph:compass-bold" class="h-8 w-8 text-text-accent" />
                <Heading level={3} size="sm" class="mt-5">{fw.titulo}</Heading>
                <Prose tone="secondary" size="sm" class="mt-3">{fw.descripcion}</Prose>
                {fw.autor && (
                  <p class="mt-4 text-xs uppercase tracking-widest text-text-muted">
                    Por {fw.autor}
                  </p>
                )}
              </Card>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {/* ENTREGABLES — muted */}
  <Section surface="muted">
    <Container>
      <div data-reveal>
        <Eyebrow>Qué te llevas</Eyebrow>
        <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
          Activos concretos, <span class="text-text-accent">no archivos sueltos</span>.
        </Heading>
        <Prose tone="secondary" size="lg" class="mt-6 max-w-2xl">
          Cada proyecto se cierra con activos que tu equipo puede usar el lunes siguiente.
          Sistemas, plantillas y guías pensadas para operar, no para guardar en una carpeta.
        </Prose>
      </div>

      <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {
          s.entregables.map((e, i) => (
            <Card variant="elevated" padding="lg" radius="xl" class="relative overflow-hidden">
              <span class="absolute right-6 top-6 font-display text-3xl font-bold text-text-accent/20">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Icon name="ph:check-circle-fill" class="h-7 w-7 text-text-accent" />
              <p class="mt-5 text-lg font-medium leading-snug text-text-primary md:text-xl">{e}</p>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* CASOS RELACIONADOS — light */}
  {
    proyectosRelacionados.length > 0 && (
      <Section surface="page">
        <Container>
          <Eyebrow>Casos relacionados</Eyebrow>
          <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
            Cómo lo aplicamos para <span class="text-text-accent">otros</span>.
          </Heading>

          <div class="mt-16 grid gap-6 md:grid-cols-2">
            {proyectosRelacionados.map((p) => (
              <Card href={`/proyectos/${p.data.slug}`} variant="elevated" padding="lg" radius="xl">
                <p class="text-sm text-text-muted">{p.data.cliente}</p>
                <Heading level={3} size="md" class="mt-2">{p.data.titulo}</Heading>
                <Prose tone="secondary" class="mt-3">{p.data.resumenCorto}</Prose>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-text-primary transition-colors group-hover:text-text-accent">
                  Ver caso
                  <Icon name="ph:arrow-right-bold" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </Card>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {/* FAQ — muted */}
  <Section surface="muted">
    <Container size="md">
      <Eyebrow>Preguntas frecuentes</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3">
        Lo que <span class="text-text-accent">siempre</span> nos preguntan.
      </Heading>

      <div class="mt-12">
        <MotionFAQ client:visible items={s.faq} />
      </div>
    </Container>
  </Section>

  {/* CTA FINAL */}
  <Section surface="page" spacing="base">
    <Container>
      <CTABlock
        eyebrow={s.title}
        headline={s.cta.headline}
        primaryCta={{ texto: s.cta.botonTexto, href: '/contacto' }}
        surface="inverse"
      />
    </Container>
  </Section>
</BaseLayout>
