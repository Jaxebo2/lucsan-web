---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Prose from '../components/ui/Prose.astro';
import Card from '../components/ui/Card.astro';
import CTABlock from '../components/ui/CTABlock.astro';
import HeroFluid from '../components/fx/HeroFluid.astro';
import MediaSlot from '../components/ui/MediaSlot.astro';
import MotionTimeline from '../components/fx/MotionTimeline.tsx';
import { Icon } from 'astro-icon/components';
import { aboutPageSchema, breadcrumbSchema } from '../lib/seo';

const entry = await getEntry('pages', 'sobre');
if (!entry || entry.data.tipo !== 'sobre') {
  throw new Error('Sobre content not found in src/content/pages/sobre.json');
}
const sobre = entry.data;

const schemas = [
  aboutPageSchema(),
  breadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Sobre nosotros', url: '/sobre-nosotros' },
  ]),
];
---

<BaseLayout title={sobre.seo.title} description={sobre.seo.description} schemas={schemas}>
  {/* HERO — dark */}
  <Section surface="inverse" spacing="none" class="relative overflow-hidden pt-32 pb-20 md:pt-44 md:pb-28">
    <HeroFluid variant="dark" intensity={0.85} />
    <Container class="relative z-10">
      <Eyebrow tone="inverse">Sobre el estudio</Eyebrow>
      <Heading level={1} size="3xl" tone="inverse" class="mt-6 max-w-5xl">
        Diseño que <span class="text-text-accent">resuelve problemas</span> de negocio.
      </Heading>
      <Prose tone="inverse-secondary" size="xl" class="mt-8 max-w-3xl">
        {sobre.manifiesto}
      </Prose>
      {
        sobre.vision && (
          <div class="mt-12 max-w-3xl border-l-2 border-brand-coral pl-6">
            <p class="text-xs font-medium uppercase tracking-widest text-text-inverse-secondary">
              Visión
            </p>
            <Prose tone="inverse" size="lg" class="mt-3">
              {sobre.vision}
            </Prose>
          </div>
        )
      }
    </Container>
  </Section>

  {/* PRINCIPIOS — light */}
  {
    sobre.principios.length > 0 && (
      <Section surface="page">
        <Container>
          <Eyebrow>Principios</Eyebrow>
          <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
            Las ideas que <span class="text-text-accent">guían</span> nuestro trabajo.
          </Heading>

          <div class="mt-16 grid gap-8 md:grid-cols-3">
            {sobre.principios.map((p, i) => (
              <div>
                <span class="font-display text-4xl font-bold text-text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <Heading level={3} size="md" class="mt-4">{p.titulo}</Heading>
                <Prose tone="secondary" class="mt-3">{p.descripcion}</Prose>
              </div>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {/* MODELO — page */}
  <Section surface="page">
    <Container size="md">
      <Eyebrow>Nuestro enfoque</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3">
        Antes de proponer, <span class="text-text-accent">analizamos</span>.
      </Heading>
      <Prose tone="secondary" size="lg" class="mt-6">
        Cruzamos la mirada del negocio, del mercado y de la audiencia antes de construir cualquier
        propuesta. Esa intersección es donde aparece el valor real que tu marca puede entregar al
        cliente correcto en el momento adecuado.
      </Prose>
    </Container>
  </Section>

  {/* MÉTODO — muted */}
  <Section surface="muted">
    <Container>
      <Eyebrow>Cómo trabajamos</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
        Un método con <span class="text-text-accent">tres fases</span>.
      </Heading>
      <Prose tone="secondary" size="lg" class="mt-6 max-w-2xl">
        El mismo proceso para cada proyecto. Sin sorpresas, con entregables claros y check-points en cada fase.
      </Prose>

      <div class="mt-16 max-w-4xl">
        <MotionTimeline
          client:visible
          variant="light"
          items={sobre.metodo.map((fase, i) => ({
            numero: String(i + 1).padStart(2, '0'),
            titulo: fase.fase.replace(/^\d+\.\s*/, ''),
            descripcion: fase.descripcion,
            entregables: fase.entregables,
          }))}
        />
      </div>
    </Container>
  </Section>

  {/* VALORES — light */}
  <Section surface="page">
    <Container>
      <Eyebrow>Lo que nos define</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
        Valores que se <span class="text-text-accent">notan</span> en cómo trabajamos.
      </Heading>

      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          sobre.valores.map((v) => (
            <div>
              <Heading level={3} size="sm">{v.titulo}</Heading>
              <Prose tone="secondary" class="mt-3">{v.descripcion}</Prose>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* EQUIPO — muted */}
  {
    sobre.equipo.length > 0 && (
      <Section surface="muted">
        <Container>
          <Eyebrow>Equipo</Eyebrow>
          <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
            Quién está <span class="text-text-accent">detrás</span> del estudio.
          </Heading>

          <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
            {sobre.equipo.map((p) => (
              <Card variant="elevated" padding="lg" radius="xl">
                {p.foto ? (
                  <img
                    src={p.foto.src}
                    alt={p.foto.alt}
                    class="mb-6 h-20 w-20 rounded-full object-cover"
                  />
                ) : (
                  <MediaSlot aspect="1/1" kind="imagen" label="Foto" class="mb-6 max-w-[80px]" />
                )}
                <Heading level={3} size="md">{p.nombre}</Heading>
                <p class="mt-1 text-sm text-text-muted">{p.rol}</p>
                <Prose tone="secondary" class="mt-4">{p.bioCorta}</Prose>
              </Card>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {/* CTA FINAL */}
  <Section surface="page" spacing="base">
    <Container>
      <CTABlock
        eyebrow="¿Empezamos?"
        headline="Cuéntanos sobre tu proyecto."
        primaryCta={{ texto: 'Conversemos', href: '/contacto' }}
        secondaryCta={{ texto: 'Ver proyectos', href: '/proyectos' }}
        surface="inverse"
      />
    </Container>
  </Section>
</BaseLayout>
