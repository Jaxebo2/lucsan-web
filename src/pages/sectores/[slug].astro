---
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Heading from '../../components/ui/Heading.astro';
import Prose from '../../components/ui/Prose.astro';
import Card from '../../components/ui/Card.astro';
import CTABlock from '../../components/ui/CTABlock.astro';
import HeroFluid from '../../components/fx/HeroFluid.astro';
import { Icon } from 'astro-icon/components';
import { breadcrumbSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const sectores = await getCollection('sectores', (s) => s.data.publicado);
  return sectores.map((sector) => ({
    params: { slug: sector.data.slug },
    props: { sector },
  }));
}

interface Props {
  sector: CollectionEntry<'sectores'>;
}

const { sector } = Astro.props;
const sec = sector.data;

const serviciosAplicables = await getEntries(sec.serviciosAplicables);
const casosRelacionados = sec.casosRelacionados.length > 0
  ? await getEntries(sec.casosRelacionados)
  : [];

const iconForService: Record<string, string> = {
  branding: 'ph:target-bold',
  'diseno-web': 'ph:browsers-bold',
  'marketing-publicidad-digital': 'ph:trend-up-bold',
  'asesoria-consultoria': 'ph:lightbulb-filament-bold',
};

const schemas = [
  breadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Sectores', url: '/sectores' },
    { name: sec.nombre, url: `/sectores/${sec.slug}` },
  ]),
];
---

<BaseLayout title={sec.seo.title} description={sec.seo.description} ogImage={sec.seo.ogImage} schemas={schemas}>
  {/* HERO — dark */}
  <Section surface="inverse" spacing="none" class="relative overflow-hidden pt-32 pb-20 md:pt-44 md:pb-28">
    <HeroFluid variant="dark" intensity={0.85} />
    <Container class="relative z-10">
      <p class="text-sm text-text-inverse-secondary">
        <a href="/sectores" class="hover:text-text-accent">Sectores</a>
        <span class="mx-2 opacity-50">/</span>
        <span class="text-text-inverse">{sec.nombre}</span>
      </p>
      <Eyebrow tone="inverse" class="mt-8">{sec.nombre}</Eyebrow>
      <Heading level={1} size="3xl" tone="inverse" class="mt-6 max-w-5xl">
        {sec.hero.headline}
      </Heading>
      <Prose tone="inverse-secondary" size="xl" class="mt-8 max-w-3xl">
        {sec.hero.subhead}
      </Prose>
    </Container>
  </Section>

  {/* CONTEXTO — light */}
  <Section surface="page">
    <Container size="md">
      <Eyebrow>Contexto del sector</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3">
        Lo que está pasando <span class="text-text-accent">hoy</span>.
      </Heading>
      <Prose tone="secondary" size="lg" class="mt-6">
        {sec.contexto}
      </Prose>
    </Container>
  </Section>

  {/* DESAFÍOS — muted */}
  <Section surface="muted">
    <Container size="md">
      <Eyebrow>Desafíos típicos</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3">
        Lo que tu empresa <span class="text-text-accent">probablemente</span> enfrenta.
      </Heading>
      <ul class="mt-12 flex flex-col gap-4">
        {
          sec.desafios.map((d) => (
            <li class="flex items-start gap-4 border-b border-border-subtle pb-4 last:border-b-0">
              <Icon name="ph:warning-circle-bold" class="mt-1 h-6 w-6 flex-none text-text-accent" />
              <span class="text-lg text-text-primary md:text-xl">{d}</span>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>

  {/* SERVICIOS APLICABLES — light */}
  <Section surface="page">
    <Container>
      <Eyebrow>Cómo te ayudamos</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
        Servicios que <span class="text-text-accent">aplicamos</span> en este sector.
      </Heading>

      <div class="mt-16 grid gap-6 md:grid-cols-3" data-reveal-stagger>
        {
          serviciosAplicables.map((svc) => (
            <Card href={`/servicios/${svc.data.slug}`} variant="default" padding="lg" radius="xl">
              <Icon name={iconForService[svc.data.slug] ?? 'ph:sparkle-bold'} class="h-10 w-10 text-text-accent" />
              <Heading level={3} size="md" class="mt-6">{svc.data.title}</Heading>
              <Prose tone="secondary" size="sm" class="mt-3">{svc.data.hero.subhead}</Prose>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-text-primary transition-colors group-hover:text-text-accent">
                Ver servicio
                <Icon name="ph:arrow-right-bold" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* NOTA ESPECIAL — accent (opcional) */}
  {
    sec.notaEspecial && (
      <Section surface="page">
        <Container size="md">
          <div class="rounded-2xl border-2 border-brand-coral/40 bg-brand-coral/5 p-8 md:p-12">
            <div class="flex items-start gap-4">
              <Icon name="ph:star-bold" class="mt-1 h-8 w-8 flex-none text-text-accent" />
              <div>
                <Heading level={3} size="md">{sec.notaEspecial.titulo}</Heading>
                <Prose tone="secondary" size="lg" class="mt-4">{sec.notaEspecial.descripcion}</Prose>
                {sec.notaEspecial.cta && (
                  <div class="mt-6">
                    <a
                      href={sec.notaEspecial.cta.href}
                      class="inline-flex items-center gap-2 font-medium text-text-accent hover:underline"
                    >
                      {sec.notaEspecial.cta.texto}
                      <Icon name="ph:arrow-right-bold" class="h-4 w-4" />
                    </a>
                  </div>
                )}
              </div>
            </div>
          </div>
        </Container>
      </Section>
    )
  }

  {/* EJEMPLOS DE TRABAJO — muted */}
  {
    sec.ejemplosTrabajo.length > 0 && (
      <Section surface="muted">
        <Container size="md">
          <Eyebrow>Ejemplos típicos</Eyebrow>
          <Heading level={2} size="2xl" class="mt-3">
            Proyectos que <span class="text-text-accent">solemos hacer</span> en este sector.
          </Heading>
          <ul class="mt-12 grid gap-3 md:grid-cols-2">
            {sec.ejemplosTrabajo.map((e) => (
              <li class="flex items-start gap-3 rounded-lg bg-surface-page p-4">
                <Icon name="ph:check-circle-fill" class="mt-0.5 h-5 w-5 flex-none text-text-accent" />
                <span class="text-text-primary">{e}</span>
              </li>
            ))}
          </ul>
        </Container>
      </Section>
    )
  }

  {/* CASOS RELACIONADOS — light */}
  {
    casosRelacionados.length > 0 && (
      <Section surface="page">
        <Container>
          <Eyebrow>Casos del sector</Eyebrow>
          <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
            Cómo lo aplicamos para <span class="text-text-accent">otros</span>.
          </Heading>
          <div class="mt-16 grid gap-6 md:grid-cols-2">
            {casosRelacionados.map((p) => (
              <Card href={`/proyectos/${p.data.slug}`} variant="elevated" padding="lg" radius="xl">
                <p class="text-sm text-text-muted">{p.data.cliente}</p>
                <Heading level={3} size="md" class="mt-2">{p.data.titulo}</Heading>
                <Prose tone="secondary" class="mt-3">{p.data.resumenCorto}</Prose>
              </Card>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {/* CTA FINAL */}
  <Section surface="page" spacing="base">
    <Container>
      <CTABlock
        eyebrow={sec.nombre}
        headline={sec.cta.headline}
        primaryCta={{ texto: sec.cta.botonTexto, href: '/contacto' }}
        surface="inverse"
      />
    </Container>
  </Section>
</BaseLayout>
