---
import { getEntry, getEntries, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Prose from '../components/ui/Prose.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CTABlock from '../components/ui/CTABlock.astro';
import MediaSlot from '../components/ui/MediaSlot.astro';
import HeroFluid from '../components/fx/HeroFluid.astro';
import Marquee from '../components/ui/Marquee.astro';
import StatCard from '../components/ui/StatCard.astro';
import PixelTrail from '../components/fx/PixelTrail.astro';
import ServiceHoverReveal from '../components/fx/ServiceHoverReveal.astro';
import ImageRevealCard from '../components/fx/ImageRevealCard.astro';
import MotionScrollMarquee from '../components/fx/MotionScrollMarquee';
import { Icon } from 'astro-icon/components';

// Read home singleton from content collection
const homeEntry = await getEntry('pages', 'home');
if (!homeEntry || homeEntry.data.tipo !== 'home') {
  throw new Error('Home content not found in src/content/pages/home.json');
}
const home = homeEntry.data;

// Resolve referenced services for "destacados".
// Fallback: si el CMS solo tiene 1 servicio destacado, completamos con los
// 3 servicios publicados de mayor orden (excluyendo asesoría) para llenar el grid.
let serviciosDestacados = await getEntries(home.serviciosDestacados);
if (serviciosDestacados.length < 3) {
  const todos = (await getCollection('services', (s) => s.data.publicado))
    .sort((a, b) => a.data.orden - b.data.orden);
  // Tomar los primeros 4 servicios publicados si no se especificaron destacados
  serviciosDestacados = todos.slice(0, 4);
}

// Icon mapping per service slug — keeps icons out of CMS (visual decisions stay in code)
const iconForService: Record<string, string> = {
  branding: 'ph:target-bold',
  'diseno-web': 'ph:browsers-bold',
  'marketing-publicidad-digital': 'ph:trend-up-bold',
  'asesoria-consultoria': 'ph:lightbulb-filament-bold',
};
---

<BaseLayout title={home.seo.title} description={home.seo.description}>
  {/* HERO */}
  <Section surface="inverse" spacing="none" class="relative flex min-h-[100vh] items-center overflow-hidden">
    {/* Interactive gradient mesh + pixel trail */}
    <HeroFluid variant="dark" intensity={1} />

    <Container class="relative z-10 pt-32 pb-24 md:pt-40" data-hero-reveal>
      <Eyebrow tone="inverse" data-hero-item>Estudio de diseño · Santiago, Chile</Eyebrow>
      <Heading level={1} size="3xl" tone="inverse" splitReveal splitStagger={60} class="mt-6 max-w-4xl" data-hero-item>
        {home.hero.headline}
      </Heading>
      <Prose tone="inverse-secondary" size="xl" class="mt-8 max-w-2xl" data-hero-item>
        {home.hero.subhead}
      </Prose>
      <div class="mt-12 flex flex-wrap gap-4" data-hero-item>
        <Button variant="primary" href={home.hero.ctaPrimario.href} iconRight="ph:arrow-right-bold">
          {home.hero.ctaPrimario.texto}
        </Button>
        {
          home.hero.ctaSecundario && (
            <Button variant="outline" href={home.hero.ctaSecundario.href}>
              {home.hero.ctaSecundario.texto}
            </Button>
          )
        }
      </div>
    </Container>
  </Section>

  {/* SERVICIOS DESTACADOS */}
  {
    serviciosDestacados.length > 0 && (
      <Section surface="page">
        <Container>
          <div data-reveal>
            <Eyebrow>Qué hacemos</Eyebrow>
            <Heading level={2} size="2xl" splitReveal class="mt-3 max-w-3xl">
              Cuatro disciplinas, <span class="text-text-accent">una sola visión</span>.
            </Heading>
          </div>

          <div class="mt-16 grid gap-5 md:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
            {serviciosDestacados.map((s) => (
              <Card href={`/servicios/${s.data.slug}`} variant="default" padding="md" radius="lg" class="aspect-square">
                <Icon
                  name={iconForService[s.data.slug] ?? 'ph:sparkle-bold'}
                  class="service-card-icon h-9 w-9 text-text-accent transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110 group-hover:rotate-6"
                />
                <Heading level={3} size="sm" class="mt-5">
                  {s.data.title}
                </Heading>
                <Prose tone="secondary" size="sm" class="mt-2 line-clamp-3 flex-1">
                  {s.data.hero.subhead}
                </Prose>
                <span class="mt-4 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-text-primary transition-colors group-hover:text-text-accent">
                  Ver servicio
                  <Icon
                    name="ph:arrow-right-bold"
                    class="h-3.5 w-3.5 transition-transform duration-500 group-hover:translate-x-1.5"
                  />
                </span>
              </Card>
            ))}
          </div>
        </Container>
      </Section>
    )
  }

  {/* MARQUEE de capacidades */}
  <Section surface="inverse" spacing="tight">
    <Marquee
      tone="inverse"
      size="md"
      speed="fast"
      items={[
        'Branding',
        'Diseño web',
        'Marketing digital',
        'Estrategia de marca',
        'Naming',
        'Identidad visual',
        'Ecommerce',
        'Performance marketing',
        'Asesoría estratégica',
        'Dirección de arte',
      ]}
    />
  </Section>

  {/* TRUST STRIP — light, con stats */}
  <Section surface="page">
    <Container>
      <div data-reveal>
        <Eyebrow>Por qué Lucsan</Eyebrow>
        <Heading level={2} size="2xl" splitReveal class="mt-3 max-w-3xl">
          Un estudio que <span class="text-text-accent">entiende negocios</span>, no solo estética.
        </Heading>
        <Prose tone="secondary" size="lg" class="mt-6 max-w-2xl">
          Trabajamos con marcas que necesitan diseño como herramienta de crecimiento, no como
          decoración. Antes de proponer cualquier cosa, hacemos las preguntas correctas.
        </Prose>
      </div>

      <div class="mt-16 grid grid-cols-2 gap-10 md:grid-cols-4" data-reveal-stagger>
        <StatCard valor="5" sufijo="años" descripcion="Diseñando marcas para empresas e instituciones en Latinoamérica." />
        <StatCard valor="20" sufijo="sectores" descripcion="Experiencia trabajando en industrias muy distintas entre sí." />
        <StatCard valor="30" prefijo="+" descripcion="Marcas que pasaron por nuestro proceso y siguen creciendo." />
        <StatCard valor="100%" descripcion="Proyectos entregados con soporte post-lanzamiento incluido." />
      </div>
    </Container>
  </Section>

  {/* CASOS RECIENTES — scroll-velocity marquee con drag */}
  <Section surface="muted">
    <Container>
      <div data-reveal class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <Eyebrow>Proyectos recientes</Eyebrow>
          <Heading level={2} size="2xl" splitReveal class="mt-3 max-w-3xl">
            Lo que hicimos para <span class="text-text-accent">otros</span>.
          </Heading>
        </div>
        <Button variant="secondary" href="/proyectos" iconRight="ph:arrow-right-bold">
          Ver todos los proyectos
        </Button>
      </div>
    </Container>

    {/* Marquee fuera del Container para que sangre full-bleed */}
    <div class="mt-12">
      <MotionScrollMarquee
        client:visible
        items={[
          { href: '/proyectos/acme-rebrand', titulo: 'Rebranding completo de Acme Corp', tag: 'Branding' },
          { href: '/proyectos', titulo: 'Próximamente', tag: 'Diseño web' },
          { href: '/proyectos', titulo: 'Próximamente', tag: 'Marketing' },
          { href: '/proyectos', titulo: 'Próximamente', tag: 'Branding' },
          { href: '/proyectos', titulo: 'Próximamente', tag: 'Identidad visual' },
        ]}
      />
    </div>
  </Section>

  {/* MÉTODO */}
  <Section surface="inverse">
    <Container>
      <Eyebrow tone="inverse">Cómo trabajamos</Eyebrow>
      <Heading level={2} size="2xl" tone="inverse" splitReveal class="mt-3 max-w-3xl">
        {home.metodoResumen.titulo}
      </Heading>

      <div class="mt-16 grid gap-12 md:grid-cols-4" data-reveal-stagger>
        {
          home.metodoResumen.fases.map((fase) => (
            <div class="metodo-phase group">
              <span class="metodo-phase__num font-display text-5xl font-bold text-text-accent transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110">
                {fase.numero}
              </span>
              <Heading level={3} size="sm" tone="inverse" class="mt-4">
                {fase.titulo}
              </Heading>
              <Prose tone="inverse-secondary" size="sm" class="mt-3">
                {fase.descripcion}
              </Prose>
            </div>
          ))
        }
      </div>

      <style>
        .metodo-phase__num {
          display: inline-block;
          transform-origin: left center;
        }
        .metodo-phase {
          transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .metodo-phase:hover {
          transform: translateY(-4px);
        }
      </style>
    </Container>
  </Section>

  {/* CTA FINAL */}
  <Section surface="page" spacing="base">
    <Container>
      <CTABlock
        eyebrow="¿Empezamos?"
        headline={home.ctaFinal.headline}
        primaryCta={{ texto: home.ctaFinal.botonTexto, href: '/contacto' }}
        secondaryCta={{ texto: 'Ver proyectos', href: '/proyectos' }}
        surface="inverse"
      />
    </Container>
  </Section>
</BaseLayout>
