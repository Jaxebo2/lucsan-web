---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Heading from '../components/ui/Heading.astro';
import Prose from '../components/ui/Prose.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import CTABlock from '../components/ui/CTABlock.astro';
import { Icon } from 'astro-icon/components';

const title = 'Lucsan Design — Estudio de branding, diseño web y marketing';
const description =
  'Estudio chileno que integra estrategia, diseño y tecnología para que tu marca crezca con sentido. Branding, diseño web y marketing digital con foco en resultados.';

const servicios = [
  {
    titulo: 'Branding',
    descripcion: 'Marcas con propósito, sistemas que escalan y una identidad que tu equipo sabe usar.',
    icon: 'ph:target-bold',
    href: '/servicios/branding',
  },
  {
    titulo: 'Diseño web',
    descripcion: 'Sitios rápidos, mensurables y pensados para convertir, no solo para verse bonitos.',
    icon: 'ph:browsers-bold',
    href: '/servicios/diseno-web',
  },
  {
    titulo: 'Marketing digital',
    descripcion: 'Campañas con estrategia detrás. Ads, contenido y analítica que se traducen en clientes.',
    icon: 'ph:trend-up-bold',
    href: '/servicios/marketing-digital',
  },
];

const fases = [
  { numero: '01', titulo: 'Descubrimiento', descripcion: 'Entendemos tu negocio, tu cliente y tu competencia antes de tocar nada visual.' },
  { numero: '02', titulo: 'Estrategia', descripcion: 'Definimos posicionamiento, mensajes clave y el plan de acción.' },
  { numero: '03', titulo: 'Diseño', descripcion: 'Iteramos en propuestas concretas hasta dar con la que conecta.' },
  { numero: '04', titulo: 'Entrega y soporte', descripcion: 'Implementación, capacitación y acompañamiento post-lanzamiento.' },
];
---

<BaseLayout title={title} description={description} transparentNav={true}>
  {/* HERO — dark section (navbar adapts) */}
  <Section surface="inverse" spacing="none" class="relative flex min-h-[100vh] items-center">
    <Container class="pt-32 pb-24 md:pt-40">
      <Eyebrow tone="inverse">Estudio de diseño · Santiago, Chile</Eyebrow>
      <Heading level={1} size="3xl" tone="inverse" class="mt-6 max-w-4xl">
        Tu marca <span class="text-text-accent">no se ve</span> como vale. Eso tiene solución.
      </Heading>
      <Prose tone="inverse-secondary" size="xl" class="mt-8 max-w-2xl">
        Diseñamos branding, sitios web y campañas que conectan con tus clientes y convierten visitas
        en negocio.
      </Prose>
      <div class="mt-12 flex flex-wrap gap-4">
        <Button variant="primary" href="/contacto" iconRight="ph:arrow-right-bold">
          Empezar un proyecto
        </Button>
        <Button variant="outline" href="/proyectos">Ver proyectos</Button>
      </div>
    </Container>
  </Section>

  {/* SERVICIOS DESTACADOS — light */}
  <Section surface="page">
    <Container>
      <Eyebrow>Qué hacemos</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
        Tres disciplinas, <span class="text-text-accent">una sola visión</span>.
      </Heading>

      <div class="mt-16 grid gap-6 md:grid-cols-3">
        {
          servicios.map((s) => (
            <Card href={s.href} variant="default">
              <Icon name={s.icon} class="h-10 w-10 text-text-accent" />
              <Heading level={3} size="md" class="mt-6">{s.titulo}</Heading>
              <Prose tone="secondary" class="mt-3">{s.descripcion}</Prose>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-text-primary transition-colors group-hover:text-text-accent">
                Ver servicio
                <Icon name="ph:arrow-right-bold" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </Card>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* CASOS RECIENTES — muted */}
  <Section surface="muted">
    <Container>
      <Eyebrow>Proyectos recientes</Eyebrow>
      <Heading level={2} size="2xl" class="mt-3 max-w-3xl">
        Lo que hicimos para <span class="text-text-accent">otros</span>.
      </Heading>
      <Prose tone="secondary" size="lg" class="mt-6 max-w-2xl">
        Cada proyecto resuelve un problema concreto. Aquí está cómo, con qué y con qué resultado.
      </Prose>
      <div class="mt-12">
        <Button variant="secondary" href="/proyectos" iconRight="ph:arrow-right-bold">
          Ver todos los proyectos
        </Button>
      </div>
    </Container>
  </Section>

  {/* MÉTODO — dark */}
  <Section surface="inverse">
    <Container>
      <Eyebrow tone="inverse">Cómo trabajamos</Eyebrow>
      <Heading level={2} size="2xl" tone="inverse" class="mt-3 max-w-3xl">
        Un método claro, <span class="text-text-accent">sin sorpresas</span>.
      </Heading>

      <div class="mt-16 grid gap-12 md:grid-cols-4">
        {
          fases.map((fase) => (
            <div>
              <span class="font-display text-5xl font-bold text-text-accent">{fase.numero}</span>
              <Heading level={3} size="sm" tone="inverse" class="mt-4">{fase.titulo}</Heading>
              <Prose tone="inverse-secondary" size="sm" class="mt-3">{fase.descripcion}</Prose>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  {/* CTA FINAL */}
  <Section surface="page" spacing="base">
    <Container>
      <CTABlock
        eyebrow="¿Empezamos?"
        headline="Cuéntanos sobre tu proyecto."
        primaryCta={{ texto: 'Conversemos', href: '/contacto' }}
        secondaryCta={{ texto: 'Ver proyectos', href: '/proyectos' }}
        surface="inverse"
      />
    </Container>
  </Section>
</BaseLayout>
