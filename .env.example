# ============================================================
# Lucsan Design — Web pública
# Copia este archivo a .env y completá los valores reales.
# ============================================================

# === Resend (transactional email — contact form) ===
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev   # sandbox; cambiar a no-reply@lucsandesign.com tras verificar dominio
CONTACT_TO_EMAIL=contacto@lucsandesign.com

# === Cloudflare Turnstile (anti-spam captcha) ===
# Sin estas variables, el captcha se desactiva (útil para dev local).
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# === Analytics (T13) ===
PUBLIC_GTM_ID=                  # ej. GTM-XXXXXXX
PUBLIC_GA4_ID=                  # ej. G-XXXXXXXXXX (solo si NO usás GTM)
PUBLIC_META_PIXEL_ID=           # ej. 1234567890123456

# === Cloudflare R2 (heavy media — T16) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lucsan-web-media
R2_PUBLIC_URL=                  # ej. https://media.lucsandesign.com

# === Site ===
PUBLIC_SITE_URL=https://lucsandesign.com
